{
  "editor.formatOnSave": true,
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  // VSCode のテスト実行（ホスト）から compose の DB に接続する。-race は make test で確認する
  "go.testEnvVars": {
    "DB_DSN": "host=localhost port=5432 user=core_user password=core_password dbname=core sslmode=disable"
  },
  "sqltools.connections": [
    {
      "previewLimit": 10000,
      "server": "localhost",
      "port": 5432,
      "driver": "PostgreSQL",
      "name": "core-db",
      "database": "core",
      "username": "core_user",
      "password": "core_password"
    }
  ]
}
