          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- queryid は文字にする（Grafana が 64 ビットの整数を小数で読み、下の桁が丸まって Loki の query_id と合わなくなるため。core#106）\nSELECT queryid::text AS queryid,\n       left(query, 400) AS query,\n       calls,\n       round(total_exec_time::numeric, 1) AS total_ms,\n       round(mean_exec_time::numeric, 2) AS mean_ms,\n       round(max_exec_time::numeric, 1) AS max_ms,\n       rows\nFROM pg_stat_statements\nWHERE dbid = (SELECT oid FROM pg_database WHERE datname = current_database())\n  AND query !~* '(pg_stat_statements|information_schema|pg_catalog)'\n  AND query !~* '^\\s*(CREATE|DROP) DATABASE'\nORDER BY total_ms DESC\nLIMIT 200"
        }
      ]
    }
  ]
}
