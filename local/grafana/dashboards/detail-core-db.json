    {
      "id": 2,
      "type": "logs",
      "title": "ERROR のログ",
      "description": "core-db の ERROR・FATAL・PANIC のログ（新しい順）。SQL のエラー・接続の失敗など",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "なし（0 件）"
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"core-db\"} | dbname=~\"$dbname\" | error_severity=~\"ERROR|FATAL|PANIC\"",
          "queryType": "range"
        }
      ]
    },
