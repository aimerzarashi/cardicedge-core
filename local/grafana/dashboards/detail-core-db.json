      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "db": 0,
              "query_id": 1,
              "sql_shape": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            },
            "renameByName": {
              "db": "DB",
              "query_id": "SQL の形の番号",
              "sql_shape": "SQL",
              "Value #A": "回数",
              "Value #B": "最大",
              "Value #C": "95%"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (db, query_id, sql_shape) (count_over_time({service_name=\"core-db\"} | dbname=~\"$dbname\" | ps!~\"CREATE DATABASE|DROP DATABASE\" | sql!~\"(?is).*(pg_stat_statements|information_schema|pg_catalog).*\" | plan!~\"(?is).*(pg_stat_statements|information_schema|pg_catalog).*\" | kind=~\"statement|execute .*\" | label_format db=`{{ if hasPrefix \"test_\" .dbname }}テスト{{ else }}{{ .dbname }}{{ end }}`, sql_shape=`{{ regexReplaceAll \"\\\\s*/\\\\*traceparent=[^*]*\\\\*/\" .sql \"\" | trunc 300 }}` [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max by (db, query_id, sql_shape) (max_over_time({service_name=\"core-db\"} | dbname=~\"$dbname\" | ps!~\"CREATE DATABASE|DROP DATABASE\" | sql!~\"(?is).*(pg_stat_statements|information_schema|pg_catalog).*\" | plan!~\"(?is).*(pg_stat_statements|information_schema|pg_catalog).*\" | kind=~\"statement|execute .*\" | label_format db=`{{ if hasPrefix \"test_\" .dbname }}テスト{{ else }}{{ .dbname }}{{ end }}`, sql_shape=`{{ regexReplaceAll \"\\\\s*/\\\\*traceparent=[^*]*\\\\*/\" .sql \"\" | trunc 300 }}` | unwrap duration_ms [$__range]))",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"core-db\"} | dbname=~\"$dbname\" | ps!~\"CREATE DATABASE|DROP DATABASE\" | sql!~\"(?is).*(pg_stat_statements|information_schema|pg_catalog).*\" | plan!~\"(?is).*(pg_stat_statements|information_schema|pg_catalog).*\" | kind=~\"statement|execute .*\" | label_format db=`{{ if hasPrefix \"test_\" .dbname }}テスト{{ else }}{{ .dbname }}{{ end }}`, sql_shape=`{{ regexReplaceAll \"\\\\s*/\\\\*traceparent=[^*]*\\\\*/\" .sql \"\" | trunc 300 }}` | unwrap duration_ms [$__range]) by (db, query_id, sql_shape)",
          "queryType": "instant"
        }
      ]
    },
