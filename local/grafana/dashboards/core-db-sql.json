{
  "uid": "core-db-sql",
  "title": "core-db の SQL",
  "tags": [
    "diecardomain",
    "core-db"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "db",
        "label": "DB",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "regex": "/^core-db/",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "重い SQL（pg_stat_statements。列の見出しで並べ替え。起動してからの累計）",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${db}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${db}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT left(query, 400) AS query,\n       calls,\n       round(total_exec_time::numeric, 1) AS total_ms,\n       round(mean_exec_time::numeric, 2) AS mean_ms,\n       round(max_exec_time::numeric, 1) AS max_ms,\n       rows\nFROM pg_stat_statements\nWHERE dbid = (SELECT oid FROM pg_database WHERE datname = current_database())\n  AND query NOT LIKE '%pg_stat_statements%'\nORDER BY total_ms DESC\nLIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "total_ms",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "query"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 700
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "遅い SQL（ログ。100ms 以上）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"core-db\"} | duration_ms != \"\" | kind != \"plan\"",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "duration_ms": true,
              "sql": true,
              "dbname": true
            },
            "indexByName": {
              "Time": 0,
              "duration_ms": 1,
              "dbname": 2,
              "sql": 3
            },
            "renameByName": {
              "Time": "時刻",
              "duration_ms": "時間(ms)",
              "dbname": "DB",
              "sql": "SQL"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SQL"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 800
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "実行計画（auto_explain。JSON）",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"core-db\"} | kind = \"plan\" | line_format \"{{.duration_ms}} ms\\n{{.plan}}\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
