  "tags": [
    "diecardomain",
    "detail",
    "core"
  ],
  "links": [
    {
      "title": "ダッシュボード",
      "type": "dashboards",
      "tags": [
        "diecardomain"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
