        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(max_over_time(otelcol_exporter_queue_size{data_type=\"traces\"}[$__range]) / on (exporter, data_type) group_left otelcol_exporter_queue_capacity) or vector(0)",
          "legendFormat": "スパン",
          "instant": true,
          "range": false
