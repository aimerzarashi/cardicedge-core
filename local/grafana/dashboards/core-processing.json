{
  "uid": "core-processing",
  "title": "core の処理（遅れ・誤り・GraphQL の時間）",
  "description": "開発の環境の、投影・ポリシーの遅れと失敗、誤りのログの数、GraphQL の操作ごとの時間（core#84）",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "diecardomain",
    "core"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "投影・ポリシーの遅れ（lag_ms の 95 パーセンタイル。発生から処理が終わるまで）",
      "description": "core の処理のログ（eventdriven: event processed）から。遅れが大きい投影・ポリシーは、テストが read model を待ちきれない原因になりうる",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"core\"} | subscriber_name!=\"\" | unwrap lag_ms [$__auto]) by (subscriber_name)",
          "queryType": "range",
          "legendFormat": "{{subscriber_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "投影・ポリシーの処理の時間（duration_ms の 95 パーセンタイル）",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=\"core\"} | subscriber_name!=\"\" | unwrap duration_ms [$__auto]) by (subscriber_name)",
          "queryType": "range",
          "legendFormat": "{{subscriber_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "投影・ポリシーの失敗の数（result=failure）",
      "description": "失敗の理由は、同じ時刻の ERROR・WARN のログ（core）で見る",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (subscriber_name) (count_over_time({service_name=\"core\"} | result=\"failure\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{subscriber_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "ERROR・WARN のログの数（core・studio・game）",
      "description": "中身は Explore で {service_name=\"core\"} | detected_level=\"error\" のように引く",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name, detected_level) (count_over_time({service_name=~\"core|studio|game\"} | detected_level=~\"error|warn\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service_name}} {{detected_level}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "core の GraphQL の操作ごとの時間（95 パーセンタイル）",
      "description": "トレースから otel-lgtm が作る指標（traces_spanmetrics）。遅い操作は Tempo で span_name を指定して個々のトレースを見る",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"core\", span_name=~\"graphql .*\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "core の GraphQL の操作ごとの呼び出しの数（毎秒）",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"core\", span_name=~\"graphql .*\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
