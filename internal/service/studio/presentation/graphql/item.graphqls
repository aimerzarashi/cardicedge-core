"アイテムの分類"
enum ItemCategory {
  "武器"
  WEAPON
  "防具"
  ARMOR
  "巻物"
  SCROLL
}

"アイテム（カードの種類の 1 つ）"
type Item implements Card {
  "公開用の ID"
  id: UUID!
  "カード名（登録したときの表記。前後の空白は除く）"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: CardStatus!
  "使うのに払う魔力（0 以上）"
  cost: Int!
  "希少度"
  rarity: CardRarity!
  "分類"
  category: ItemCategory!
  "効果の並び（入れた順。無ければ空）"
  effects: [ItemEffect!]!
  "今の分類で持てる効果の種類（画面が選べるものだけを出すため。分類ごとの決まりは core が持つ）"
  allowedEffectKinds: [ItemEffectKind!]!
  "更新の番号（画面が見ていた版。公開する・使用不可にする操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

"アイテムを登録する入力"
input RegisterItemInput {
  "カード名（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

"アイテムを登録した"
type RegisterItemSuccess {
  "登録したアイテム"
  item: Item!
}

"アイテムの登録の結果"
union RegisterItemResult = RegisterItemSuccess | ValidationErrors | CardNameAlreadyInUseError | ForbiddenError

"アイテムの分類を変える入力"
input ChangeItemCategoryInput {
  "変えるアイテムの公開用の ID"
  id: UUID!
  "画面が見ていたカードの更新の番号"
  revision: Int!
  "変えた後の分類"
  category: ItemCategory!
}

"アイテムの分類を変えた（同じ値なら revision は進まない）"
type ChangeItemCategorySuccess {
  "変えたアイテムの公開用の ID"
  id: UUID!
  "操作した後の更新の番号"
  revision: Int!
}

"アイテムの分類を変える操作の結果（カードでない ID・アイテム以外のカードの ID は CardNotFoundError）"
union ChangeItemCategoryResult = ChangeItemCategorySuccess | ValidationErrors | CardNotFoundError | RevisionConflictError | CardNotDraftError | ItemEffectNotAllowedError | ForbiddenError

# 能力は「呼び名」でなく効果を単位にし、タイミングは効果の種類で決まる（2026-11-14 オーナー。core#177）。
# 「強打」のような言葉は画面のラベルで、ここには持たない
"アイテムの効果の種類"
enum ItemEffectKind {
  "AT の増減（戦闘中、AT が決まった値だけ増減する）"
  ATTACK_MODIFIER
  "HP の増減（戦闘中、HP が決まった値だけ増減する）"
  HIT_POINTS_MODIFIER
  "AT の上書き（戦闘中、AT が決まった値になる）"
  ATTACK_OVERRIDE
  "AT の倍率（制約を満たすとき、増減・上書きの後に AT に倍率を掛ける。発動したうち一番高い倍率を 1 回だけ）"
  ATTACK_MULTIPLIER
  "地形効果を無視する（相手の地形効果を無視してダメージを与える）"
  IGNORE_TERRAIN_EFFECT
}

"アイテムの効果（種類ごとの型）"
interface ItemEffect {
  "効果の種類"
  kind: ItemEffectKind!
}

"AT の増減"
type ItemAttackModifierEffect implements ItemEffect {
  "効果の種類"
  kind: ItemEffectKind!
  "増減の値（負は下げる）"
  value: Int!
}

"HP の増減"
type ItemHitPointsModifierEffect implements ItemEffect {
  "効果の種類"
  kind: ItemEffectKind!
  "増減の値（負は下げる）"
  value: Int!
}

"AT の上書き"
type ItemAttackOverrideEffect implements ItemEffect {
  "効果の種類"
  kind: ItemEffectKind!
  "上書きした後の AT（0 以上）"
  value: Int!
}

"AT の倍率"
type ItemAttackMultiplierEffect implements ItemEffect {
  "効果の種類"
  kind: ItemEffectKind!
  "倍率（百分率。150 で 1.5 倍。1 以上）"
  percent: Int!
  "発動する制約（すべてを満たすときに発動する。無ければ空でいつも発動する）"
  constraints: [ItemConstraint!]!
}

"地形効果を無視する"
type ItemIgnoreTerrainEffect implements ItemEffect {
  "効果の種類"
  kind: ItemEffectKind!
}

"効果の制約の種類"
enum ItemConstraintKind {
  "相手の属性（戦う相手のクリーチャーの属性のどれかが合うとき）"
  OPPONENT_ELEMENT
}

"効果の制約（種類ごとの型）"
interface ItemConstraint {
  "制約の種類"
  kind: ItemConstraintKind!
}

"相手の属性の制約"
type ItemOpponentElementConstraint implements ItemConstraint {
  "制約の種類"
  kind: ItemConstraintKind!
  "合えば満たす相手の属性（火・地・水・風・無の順。1 つ以上）"
  elements: [CreatureElement!]!
}

"アイテムの効果の入力（種類に要る値だけを入れる。AT・HP の増減・AT の上書きは value、AT の倍率は percent と constraints）"
input ItemEffectInput {
  "効果の種類"
  kind: ItemEffectKind!
  "AT・HP の増減の値・上書きした後の AT"
  value: Int
  "AT の倍率（百分率）"
  percent: Int
  "AT の倍率の制約（すべてを満たすときに発動する）"
  constraints: [ItemConstraintInput!]
}

"効果の制約の入力"
input ItemConstraintInput {
  "制約の種類"
  kind: ItemConstraintKind!
  "相手の属性（1 つ以上・重複なし）"
  elements: [CreatureElement!]
}

"アイテムの効果の並びを変える入力"
input ChangeItemEffectsInput {
  "変えるアイテムの公開用の ID"
  id: UUID!
  "画面が見ていたカードの更新の番号"
  revision: Int!
  "変えた後の効果の並び（全体。並びの順に当てる）"
  effects: [ItemEffectInput!]!
}

"アイテムの効果の並びを変えた（同じ並びなら revision は進まない）"
type ChangeItemEffectsSuccess {
  "変えたアイテムの公開用の ID"
  id: UUID!
  "操作した後の更新の番号"
  revision: Int!
}

"アイテムの分類で持てない効果がある（効果を変えるとき・分類を変えるとき。持てる効果は分類ごとに決まっている）"
type ItemEffectNotAllowedError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"アイテムの効果の並びを変える操作の結果（入力の誤りの項目は effects.N・effects.N.value・effects.N.percent・effects.N.constraints.M・effects.N.constraints.M.elements。カードでない ID・アイテム以外のカードの ID は CardNotFoundError）"
union ChangeItemEffectsResult = ChangeItemEffectsSuccess | ValidationErrors | CardNotFoundError | RevisionConflictError | CardNotDraftError | ItemEffectNotAllowedError | ForbiddenError

extend type Mutation {
  "アイテムの分類を変える（紐づいたオペレーターだけ。準備中だけ）"
  changeItemCategory(
    "変えるアイテムと分類"
    input: ChangeItemCategoryInput!
  ): ChangeItemCategoryResult!
  "アイテムの効果の並びを変える（紐づいたオペレーターだけ。準備中だけ。分類で持てる効果だけ）"
  changeItemEffects(
    "変えるアイテムと効果の並び"
    input: ChangeItemEffectsInput!
  ): ChangeItemEffectsResult!
  "アイテムを登録する（紐づいたオペレーターだけ）"
  registerItem(
    "登録するアイテム"
    input: RegisterItemInput!
  ): RegisterItemResult!
}
