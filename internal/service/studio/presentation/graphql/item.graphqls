"アイテムの分類"
enum ItemCategory {
  "武器"
  WEAPON
  "防具"
  ARMOR
  "巻物"
  SCROLL
}

"アイテム（カードの種類の 1 つ）"
type Item implements Card {
  "公開用の ID"
  id: UUID!
  "カード名（登録したときの表記。前後の空白は除く）"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: CardStatus!
  "使うのに払う魔力（0 以上）"
  cost: Int!
  "希少度"
  rarity: CardRarity!
  "分類"
  category: ItemCategory!
  "戦闘中に足す攻撃力（負は下げる）"
  attackBonus: Int!
  "戦闘中に足す体力（負は下げる）"
  hitPointsBonus: Int!
  "更新の番号（画面が見ていた版。公開する・使用不可にする操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

"アイテムを登録する入力"
input RegisterItemInput {
  "カード名（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

"アイテムを登録した"
type RegisterItemSuccess {
  "登録したアイテム"
  item: Item!
}

"アイテムの登録の結果"
union RegisterItemResult = RegisterItemSuccess | ValidationErrors | CardNameAlreadyInUseError | ForbiddenError

"アイテムの分類を変える入力"
input ChangeItemCategoryInput {
  "変えるアイテムの公開用の ID"
  id: UUID!
  "画面が見ていたカードの更新の番号"
  revision: Int!
  "変えた後の分類"
  category: ItemCategory!
}

"アイテムの分類を変えた（同じ値なら revision は進まない）"
type ChangeItemCategorySuccess {
  "変えたアイテムの公開用の ID"
  id: UUID!
  "操作した後の更新の番号"
  revision: Int!
}

"アイテムの分類を変える操作の結果（カードでない ID・アイテム以外のカードの ID は CardNotFoundError）"
union ChangeItemCategoryResult = ChangeItemCategorySuccess | ValidationErrors | CardNotFoundError | RevisionConflictError | CardNotDraftError | ForbiddenError

"アイテムの戦闘中の AT・HP の増減を変える入力"
input ChangeItemStatBonusesInput {
  "変えるアイテムの公開用の ID"
  id: UUID!
  "画面が見ていたカードの更新の番号"
  revision: Int!
  "戦闘中に足す攻撃力（負は下げる）"
  attackBonus: Int!
  "戦闘中に足す体力（負は下げる）"
  hitPointsBonus: Int!
}

"アイテムの戦闘中の AT・HP の増減を変えた（どちらも同じ値なら revision は進まない）"
type ChangeItemStatBonusesSuccess {
  "変えたアイテムの公開用の ID"
  id: UUID!
  "操作した後の更新の番号"
  revision: Int!
}

"アイテムの増減を変える操作の結果（カードでない ID・アイテム以外のカードの ID は CardNotFoundError）"
union ChangeItemStatBonusesResult = ChangeItemStatBonusesSuccess | ValidationErrors | CardNotFoundError | RevisionConflictError | CardNotDraftError | ForbiddenError

extend type Mutation {
  "アイテムの分類を変える（紐づいたオペレーターだけ。準備中だけ）"
  changeItemCategory(
    "変えるアイテムと分類"
    input: ChangeItemCategoryInput!
  ): ChangeItemCategoryResult!
  "アイテムの戦闘中の AT・HP の増減を変える（紐づいたオペレーターだけ。準備中だけ。2 つは一緒に変える）"
  changeItemStatBonuses(
    "変えるアイテムと増減"
    input: ChangeItemStatBonusesInput!
  ): ChangeItemStatBonusesResult!
  "アイテムを登録する（紐づいたオペレーターだけ）"
  registerItem(
    "登録するアイテム"
    input: RegisterItemInput!
  ): RegisterItemResult!
}
