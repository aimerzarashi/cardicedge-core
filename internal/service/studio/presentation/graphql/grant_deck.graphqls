# 配布デッキ（新しいプレイヤーに配るデッキ。1 デッキ 1 集約。core#42）。空から作るか、プリセットデッキから写して作る。
# 写した後に元のプリセットデッキを直しても変わらない（反映するには作り直す）。公開中のものだけを game に写して配る

"配布デッキ"
type GrantDeck {
  "公開用の ID"
  id: UUID!
  "名前（登録・変更したときの表記。前後の空白は除く。状態によらず、すべての配布デッキの中で一意）"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: GrantDeckStatus!
  # 名前・種類は read model に書き写さず、データローダーで引いてから並べる（プリセットデッキと同じ）
  "入れたカードと枚数（カードの一覧と同じ並び: 種類の順（Creature → Item → Spell）、同じ種類の中は名前の順）"
  cards: [DeckCard!]!
  "カードの枚数の合計"
  totalCount: Int!
  "プリセットデッキから写して作ったときの写し元（空から作ったときは null）"
  source: GrantDeckSource
  "更新の番号（画面が見ていた版。変える・消す操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

# 準備中から使用不可へ直接は移れず、公開中から準備中へも戻れない。公開中にもう一度公開する・使用不可にもう一度使用不可にするのは、
# 変わらない操作として成功する（カードの状態と同じ）
"""
配布デッキの状態。準備中は名前・カードを自由に変えられ、決まり（40 枚等）を満たさなくてよい。公開中は決まりを満たし、
新しいプレイヤーに配る。使用不可は配らない（配り済みのデッキはプレイヤーの持ち物なので変わらない）
"""
enum GrantDeckStatus {
  "準備中（登録したときの状態）"
  DRAFT
  "公開中"
  PUBLISHED
  "使用不可"
  RETIRED
}

# 元は参照（消せない制約）にしないため、消されていることもある。そのときは presetDeckDeleted が true になり、changedSinceCopied は
# false（比べる相手が無い）
"写した元"
type GrantDeckSource {
  "元のプリセットデッキの公開用の ID（消されていることもある）"
  presetDeckId: UUID!
  "写したときの、元のプリセットデッキの revision"
  revision: Int!
  "写した後に、元のプリセットデッキが変わっている（元が削除されていれば false）"
  changedSinceCopied: Boolean!
  "元のプリセットデッキが削除されている"
  presetDeckDeleted: Boolean!
}

"名前が、ほかの配布デッキですでに使われている（状態によらない）。カード名と同じ比べ方（前後の空白を除き、全角・半角、大文字・小文字の違いを同じとみなす）"
type GrantDeckNameAlreadyInUseError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"配布デッキが無い（削除したものを含む）"
type GrantDeckNotFoundError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"準備中の配布デッキを使用不可にしようとした（準備中から移れるのは公開中だけ）"
type InvalidGrantDeckStatusTransitionError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"準備中でない配布デッキの名前・枚数を変える、または削除しようとした（準備中のものだけ変えられる）"
type GrantDeckNotDraftError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"公開中の配布デッキの数が上限に達している（ほかのものを使用不可にすると公開できる）"
type GrantDeckLimitReachedError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
  "公開中の配布デッキの数の上限（そのときのゲーム全体のルールの値。画面が文言に出す）"
  max: Int!
}

"配布デッキの一覧の絞り込み"
input GrantDeckFilter {
  "名前に含まれる文字（前後の空白を除き、全角・半角、大文字・小文字の違いは無視する。空・空白だけは入力の誤り。50 文字まで）"
  nameContains: String
  "状態（指定が無ければすべて。空のリストは入力の誤り）"
  statuses: [GrantDeckStatus!]
}

"配布デッキの一覧の 1 件と、その位置"
type GrantDeckEdge {
  "この 1 件の位置（次のページを取るときに after に渡す）"
  cursor: String!
  "配布デッキ"
  node: GrantDeck!
}

"配布デッキの一覧の 1 ページ（名前の順）"
type GrantDeckConnection {
  "このページの配布デッキ"
  edges: [GrantDeckEdge!]!
  "ページの情報"
  pageInfo: PageInfo!
}

"配布デッキの一覧の結果"
union GrantDecksResult = GrantDeckConnection | ValidationErrors | ForbiddenError

"配布デッキの詳細の結果"
union GrantDeckResult = GrantDeck | GrantDeckNotFoundError | ForbiddenError

extend type Query {
  "配布デッキの一覧（紐づいたオペレーターだけ）"
  grantDecks(
    "絞り込み"
    filter: GrantDeckFilter
    "1 ページの件数（1〜100。指定が無ければ 50）"
    first: Int
    "前のページの pageInfo.endCursor（指定が無ければ最初のページ）"
    after: String
  ): GrantDecksResult!
  "配布デッキの詳細（紐づいたオペレーターだけ）"
  grantDeck(
    "配布デッキの公開用の ID"
    id: UUID!
  ): GrantDeckResult!
}

"配布デッキを空から登録する入力"
input RegisterGrantDeckInput {
  "名前（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

# 変える操作の結果は、公開 ID と新しい revision だけにする（PresetDeck と同じ）
"配布デッキを登録した（準備中）"
type RegisterGrantDeckSuccess {
  "登録した配布デッキの公開用の ID"
  id: UUID!
  "登録した配布デッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"配布デッキの登録の結果"
union RegisterGrantDeckResult = RegisterGrantDeckSuccess | ValidationErrors | GrantDeckNameAlreadyInUseError | ForbiddenError

"配布デッキをプリセットデッキから写して登録する入力"
input RegisterGrantDeckFromPresetDeckInput {
  "写す元のプリセットデッキの公開用の ID（カードと枚数を写す。合計が 40 枚でなくてもよい）"
  presetDeckId: UUID!
  "名前（1〜50 文字。前後の空白は除いて保存する。元のプリセットデッキの名前は写さない）"
  name: String!
}

"プリセットデッキから写して配布デッキを登録した（準備中。写した元の公開 ID と revision を記録する）"
type RegisterGrantDeckFromPresetDeckSuccess {
  "登録した配布デッキの公開用の ID"
  id: UUID!
  "登録した配布デッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"プリセットデッキから写した配布デッキの登録の結果"
union RegisterGrantDeckFromPresetDeckResult =
    RegisterGrantDeckFromPresetDeckSuccess
  | ValidationErrors
  | PresetDeckNotFoundError
  | GrantDeckNameAlreadyInUseError
  | ForbiddenError

"配布デッキの名前を変える入力"
input RenameGrantDeckInput {
  "配布デッキの公開用の ID"
  id: UUID!
  "画面が見ていた配布デッキの revision"
  revision: Int!
  "新しい名前（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

"配布デッキの名前を変えた（同じ名前なら何も変えず、revision も進まない）"
type RenameGrantDeckSuccess {
  "変えた配布デッキの公開用の ID"
  id: UUID!
  "変えた配布デッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"配布デッキの名前の変更の結果（準備中のものだけ変えられる）"
union RenameGrantDeckResult =
    RenameGrantDeckSuccess
  | ValidationErrors
  | GrantDeckNotFoundError
  | GrantDeckNameAlreadyInUseError
  | GrantDeckNotDraftError
  | RevisionConflictError
  | ForbiddenError

"配布デッキのカードの枚数を変える入力"
input SetGrantDeckCardCountsInput {
  "配布デッキの公開用の ID"
  id: UUID!
  "画面が見ていた配布デッキの revision"
  revision: Int!
  "変えるカードだけの一覧（40 件まで。変えないカードは含めなくてよい。同じカードを 2 回入れると入力の誤り。空なら何も変えない。変えた後の枚数の合計が 40 を超えると入力の誤り。新しく入れる・増やすカードは公開中だけ）"
  cards: [DeckCardCountInput!]!
}

"配布デッキのカードの枚数を変えた（1 回の操作で revision は 1 つ進む。何も変わらなければ進まない）"
type SetGrantDeckCardCountsSuccess {
  "変えた配布デッキの公開用の ID"
  id: UUID!
  "変えた配布デッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"配布デッキのカードの枚数の変更の結果（一覧のどれか 1 つでも誤りがあれば、何も変えない。準備中のものだけ変えられる）"
union SetGrantDeckCardCountsResult =
    SetGrantDeckCardCountsSuccess
  | ValidationErrors
  | GrantDeckNotFoundError
  | GrantDeckNotDraftError
  | RevisionConflictError
  | ForbiddenError

"配布デッキを削除する入力"
input DeleteGrantDeckInput {
  "配布デッキの公開用の ID"
  id: UUID!
  "画面が見ていた配布デッキの revision"
  revision: Int!
}

"配布デッキを削除した（名前はほかの配布デッキが使えるようになる）"
type DeleteGrantDeckSuccess {
  "削除した配布デッキの公開用の ID"
  id: UUID!
}

"配布デッキの削除の結果（準備中のものだけ消せる）"
union DeleteGrantDeckResult =
    DeleteGrantDeckSuccess
  | GrantDeckNotFoundError
  | GrantDeckNotDraftError
  | RevisionConflictError
  | ForbiddenError

"配布デッキを公開する入力"
input PublishGrantDeckInput {
  "配布デッキの公開用の ID"
  id: UUID!
  "画面が見ていた配布デッキの revision"
  revision: Int!
}

"配布デッキを公開中にした（すでに公開中なら何も変えず、revision も進まない）"
type PublishGrantDeckSuccess {
  "公開した配布デッキの公開用の ID"
  id: UUID!
  "公開した配布デッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

# 公開するときの誤りは ValidationErrors の項目 cards に付ける: 合計がちょうど 40 枚でない（FieldTotalMismatch）、
# 入っているカードに公開中でないものがある（FieldUnavailable）
"配布デッキの公開の結果（準備中・使用不可から公開中にできる。公開中の数が上限なら公開できない）"
union PublishGrantDeckResult =
    PublishGrantDeckSuccess
  | ValidationErrors
  | GrantDeckNotFoundError
  | GrantDeckLimitReachedError
  | RevisionConflictError
  | ForbiddenError

"配布デッキを使用不可にする入力"
input RetireGrantDeckInput {
  "配布デッキの公開用の ID"
  id: UUID!
  "画面が見ていた配布デッキの revision"
  revision: Int!
}

"配布デッキを使用不可にした（すでに使用不可なら何も変えず、revision も進まない。新しいプレイヤーには配らない）"
type RetireGrantDeckSuccess {
  "使用不可にした配布デッキの公開用の ID"
  id: UUID!
  "使用不可にした配布デッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"配布デッキの使用不可の結果"
union RetireGrantDeckResult =
    RetireGrantDeckSuccess
  | GrantDeckNotFoundError
  | InvalidGrantDeckStatusTransitionError
  | RevisionConflictError
  | ForbiddenError

extend type Mutation {
  "配布デッキを空から登録する（準備中。紐づいたオペレーターだけ）"
  registerGrantDeck(
    "登録する配布デッキ"
    input: RegisterGrantDeckInput!
  ): RegisterGrantDeckResult!
  "プリセットデッキから写して配布デッキを登録する（準備中。紐づいたオペレーターだけ）"
  registerGrantDeckFromPresetDeck(
    "写す元"
    input: RegisterGrantDeckFromPresetDeckInput!
  ): RegisterGrantDeckFromPresetDeckResult!
  "配布デッキの名前を変える（準備中のものだけ。紐づいたオペレーターだけ）"
  renameGrantDeck(
    "変える内容"
    input: RenameGrantDeckInput!
  ): RenameGrantDeckResult!
  "配布デッキのカードの枚数を変える（準備中のものだけ。紐づいたオペレーターだけ）"
  setGrantDeckCardCounts(
    "変える内容"
    input: SetGrantDeckCardCountsInput!
  ): SetGrantDeckCardCountsResult!
  "配布デッキを削除する（準備中のものだけ。紐づいたオペレーターだけ）"
  deleteGrantDeck(
    "削除する配布デッキ"
    input: DeleteGrantDeckInput!
  ): DeleteGrantDeckResult!
  "配布デッキを公開中にする（紐づいたオペレーターだけ）"
  publishGrantDeck(
    "公開する配布デッキ"
    input: PublishGrantDeckInput!
  ): PublishGrantDeckResult!
  "配布デッキを使用不可にする（紐づいたオペレーターだけ）"
  retireGrantDeck(
    "使用不可にする配布デッキ"
    input: RetireGrantDeckInput!
  ): RetireGrantDeckResult!
}
