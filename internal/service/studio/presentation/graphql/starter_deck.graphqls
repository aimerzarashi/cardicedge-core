# スターターデッキ（新しいプレイヤーに配るデッキ。1 デッキ 1 集約。core#42）。空から作るか、プリセットデッキから写して作る。
# 写した後に元のプリセットデッキを直しても変わらない（反映するには作り直す）。公開中のものだけを game に写して配る

"スターターデッキ"
type StarterDeck {
  "公開用の ID"
  id: UUID!
  "名前（登録・変更したときの表記。前後の空白は除く。状態によらず、すべてのスターターデッキの中で一意）"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: StarterDeckStatus!
  # 名前・種類は read model に書き写さず、データローダーで引いてから並べる（プリセットデッキと同じ）
  "入れたカードと枚数（カードの一覧と同じ並び: 種類の順（Creature → Item → Spell）、同じ種類の中は名前の順）"
  cards: [DeckCard!]!
  "カードの枚数の合計"
  totalCount: Int!
  "プリセットデッキから写して作ったときの写し元（空から作ったときは null）"
  source: StarterDeckSource
  "更新の番号（画面が見ていた版。変える・消す操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

# 準備中から使用不可へ直接は移れず、公開中から準備中へも戻れない。公開中にもう一度公開する・使用不可にもう一度使用不可にするのは、
# 変わらない操作として成功する（カードの状態と同じ）
"""
スターターデッキの状態。準備中は名前・カードを自由に変えられ、決まり（40 枚等）を満たさなくてよい。公開中は決まりを満たし、
新しいプレイヤーに配る。使用不可は配らない（配り済みのデッキはプレイヤーの持ち物なので変わらない）
"""
enum StarterDeckStatus {
  "準備中（登録したときの状態）"
  DRAFT
  "公開中"
  PUBLISHED
  "使用不可"
  RETIRED
}

# 元は参照（消せない制約）にしないため、消されていることもある。そのときは presetDeckDeleted が true になり、changedSinceCopied は
# false（比べる相手が無い）
"写した元"
type StarterDeckSource {
  "元のプリセットデッキの公開用の ID（消されていることもある）"
  presetDeckId: UUID!
  "写したときの、元のプリセットデッキの revision"
  revision: Int!
  "写した後に、元のプリセットデッキが変わっている（元が削除されていれば false）"
  changedSinceCopied: Boolean!
  "元のプリセットデッキが削除されている"
  presetDeckDeleted: Boolean!
}

"名前が、ほかのスターターデッキですでに使われている（状態によらない）。カード名と同じ比べ方（前後の空白を除き、全角・半角、大文字・小文字の違いを同じとみなす）"
type StarterDeckNameAlreadyInUseError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"スターターデッキが無い（削除したものを含む）"
type StarterDeckNotFoundError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"準備中のスターターデッキを使用不可にしようとした（準備中から移れるのは公開中だけ）"
type InvalidStarterDeckStatusTransitionError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"準備中でないスターターデッキの名前・枚数を変える、または削除しようとした（準備中のものだけ変えられる）"
type StarterDeckNotDraftError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"公開中のスターターデッキの数が上限に達している（ほかのものを使用不可にすると公開できる）"
type StarterDeckLimitReachedError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"スターターデッキの一覧の絞り込み"
input StarterDeckFilter {
  "名前に含まれる文字（前後の空白を除き、全角・半角、大文字・小文字の違いは無視する。空・空白だけは入力の誤り。50 文字まで）"
  nameContains: String
  "状態（指定が無ければすべて。空のリストは入力の誤り）"
  statuses: [StarterDeckStatus!]
}

"スターターデッキの一覧の 1 件と、その位置"
type StarterDeckEdge {
  "この 1 件の位置（次のページを取るときに after に渡す）"
  cursor: String!
  "スターターデッキ"
  node: StarterDeck!
}

"スターターデッキの一覧の 1 ページ（名前の順）"
type StarterDeckConnection {
  "このページのスターターデッキ"
  edges: [StarterDeckEdge!]!
  "ページの情報"
  pageInfo: PageInfo!
}

"スターターデッキの一覧の結果"
union StarterDecksResult = StarterDeckConnection | ValidationErrors | ForbiddenError

"スターターデッキの詳細の結果"
union StarterDeckResult = StarterDeck | StarterDeckNotFoundError | ForbiddenError

extend type Query {
  "スターターデッキの一覧（紐づいたオペレーターだけ）"
  starterDecks(
    "絞り込み"
    filter: StarterDeckFilter
    "1 ページの件数（1〜100。指定が無ければ 50）"
    first: Int
    "前のページの pageInfo.endCursor（指定が無ければ最初のページ）"
    after: String
  ): StarterDecksResult!
  "スターターデッキの詳細（紐づいたオペレーターだけ）"
  starterDeck(
    "スターターデッキの公開用の ID"
    id: UUID!
  ): StarterDeckResult!
}

"スターターデッキを空から登録する入力"
input RegisterStarterDeckInput {
  "名前（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

# 変える操作の結果は、公開 ID と新しい revision だけにする（PresetDeck と同じ）
"スターターデッキを登録した（準備中）"
type RegisterStarterDeckSuccess {
  "登録したスターターデッキの公開用の ID"
  id: UUID!
  "登録したスターターデッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"スターターデッキの登録の結果"
union RegisterStarterDeckResult = RegisterStarterDeckSuccess | ValidationErrors | StarterDeckNameAlreadyInUseError | ForbiddenError

"スターターデッキをプリセットデッキから写して登録する入力"
input RegisterStarterDeckFromPresetDeckInput {
  "写す元のプリセットデッキの公開用の ID（名前・カードと枚数を写す。合計が 40 枚でなくてもよい）"
  presetDeckId: UUID!
}

"プリセットデッキから写してスターターデッキを登録した（準備中。写した元の公開 ID と revision を記録する）"
type RegisterStarterDeckFromPresetDeckSuccess {
  "登録したスターターデッキの公開用の ID"
  id: UUID!
  "登録したスターターデッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"プリセットデッキから写したスターターデッキの登録の結果"
union RegisterStarterDeckFromPresetDeckResult =
    RegisterStarterDeckFromPresetDeckSuccess
  | PresetDeckNotFoundError
  | StarterDeckNameAlreadyInUseError
  | ForbiddenError

"スターターデッキの名前を変える入力"
input RenameStarterDeckInput {
  "スターターデッキの公開用の ID"
  id: UUID!
  "画面が見ていたスターターデッキの revision"
  revision: Int!
  "新しい名前（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

"スターターデッキの名前を変えた（同じ名前なら何も変えず、revision も進まない）"
type RenameStarterDeckSuccess {
  "変えたスターターデッキの公開用の ID"
  id: UUID!
  "変えたスターターデッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"スターターデッキの名前の変更の結果（準備中のものだけ変えられる）"
union RenameStarterDeckResult =
    RenameStarterDeckSuccess
  | ValidationErrors
  | StarterDeckNotFoundError
  | StarterDeckNameAlreadyInUseError
  | StarterDeckNotDraftError
  | RevisionConflictError
  | ForbiddenError

"スターターデッキのカードの枚数を変える入力"
input SetStarterDeckCardCountsInput {
  "スターターデッキの公開用の ID"
  id: UUID!
  "画面が見ていたスターターデッキの revision"
  revision: Int!
  "変えるカードだけの一覧（40 件まで。変えないカードは含めなくてよい。同じカードを 2 回入れると入力の誤り。空なら何も変えない。変えた後の枚数の合計が 40 を超えると入力の誤り。新しく入れる・増やすカードは公開中だけ）"
  cards: [DeckCardCountInput!]!
}

"スターターデッキのカードの枚数を変えた（1 回の操作で revision は 1 つ進む。何も変わらなければ進まない）"
type SetStarterDeckCardCountsSuccess {
  "変えたスターターデッキの公開用の ID"
  id: UUID!
  "変えたスターターデッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"スターターデッキのカードの枚数の変更の結果（一覧のどれか 1 つでも誤りがあれば、何も変えない。準備中のものだけ変えられる）"
union SetStarterDeckCardCountsResult =
    SetStarterDeckCardCountsSuccess
  | ValidationErrors
  | StarterDeckNotFoundError
  | StarterDeckNotDraftError
  | RevisionConflictError
  | ForbiddenError

"スターターデッキを削除する入力"
input DeleteStarterDeckInput {
  "スターターデッキの公開用の ID"
  id: UUID!
  "画面が見ていたスターターデッキの revision"
  revision: Int!
}

"スターターデッキを削除した（名前はほかのスターターデッキが使えるようになる）"
type DeleteStarterDeckSuccess {
  "削除したスターターデッキの公開用の ID"
  id: UUID!
}

"スターターデッキの削除の結果（準備中のものだけ消せる）"
union DeleteStarterDeckResult =
    DeleteStarterDeckSuccess
  | StarterDeckNotFoundError
  | StarterDeckNotDraftError
  | RevisionConflictError
  | ForbiddenError

"スターターデッキを公開する入力"
input PublishStarterDeckInput {
  "スターターデッキの公開用の ID"
  id: UUID!
  "画面が見ていたスターターデッキの revision"
  revision: Int!
}

"スターターデッキを公開中にした（すでに公開中なら何も変えず、revision も進まない）"
type PublishStarterDeckSuccess {
  "公開したスターターデッキの公開用の ID"
  id: UUID!
  "公開したスターターデッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

# 公開するときの誤りは ValidationErrors の項目 cards に付ける: 合計がちょうど 40 枚でない（FieldTotalMismatch）、
# 入っているカードに公開中でないものがある（FieldUnavailable）
"スターターデッキの公開の結果（準備中・使用不可から公開中にできる。公開中の数が上限なら公開できない）"
union PublishStarterDeckResult =
    PublishStarterDeckSuccess
  | ValidationErrors
  | StarterDeckNotFoundError
  | StarterDeckLimitReachedError
  | RevisionConflictError
  | ForbiddenError

"スターターデッキを使用不可にする入力"
input RetireStarterDeckInput {
  "スターターデッキの公開用の ID"
  id: UUID!
  "画面が見ていたスターターデッキの revision"
  revision: Int!
}

"スターターデッキを使用不可にした（すでに使用不可なら何も変えず、revision も進まない。新しいプレイヤーには配らない）"
type RetireStarterDeckSuccess {
  "使用不可にしたスターターデッキの公開用の ID"
  id: UUID!
  "使用不可にしたスターターデッキの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"スターターデッキの使用不可の結果"
union RetireStarterDeckResult =
    RetireStarterDeckSuccess
  | StarterDeckNotFoundError
  | InvalidStarterDeckStatusTransitionError
  | RevisionConflictError
  | ForbiddenError

extend type Mutation {
  "スターターデッキを空から登録する（準備中。紐づいたオペレーターだけ）"
  registerStarterDeck(
    "登録するスターターデッキ"
    input: RegisterStarterDeckInput!
  ): RegisterStarterDeckResult!
  "プリセットデッキから写してスターターデッキを登録する（準備中。紐づいたオペレーターだけ）"
  registerStarterDeckFromPresetDeck(
    "写す元"
    input: RegisterStarterDeckFromPresetDeckInput!
  ): RegisterStarterDeckFromPresetDeckResult!
  "スターターデッキの名前を変える（準備中のものだけ。紐づいたオペレーターだけ）"
  renameStarterDeck(
    "変える内容"
    input: RenameStarterDeckInput!
  ): RenameStarterDeckResult!
  "スターターデッキのカードの枚数を変える（準備中のものだけ。紐づいたオペレーターだけ）"
  setStarterDeckCardCounts(
    "変える内容"
    input: SetStarterDeckCardCountsInput!
  ): SetStarterDeckCardCountsResult!
  "スターターデッキを削除する（準備中のものだけ。紐づいたオペレーターだけ）"
  deleteStarterDeck(
    "削除するスターターデッキ"
    input: DeleteStarterDeckInput!
  ): DeleteStarterDeckResult!
  "スターターデッキを公開中にする（紐づいたオペレーターだけ）"
  publishStarterDeck(
    "公開するスターターデッキ"
    input: PublishStarterDeckInput!
  ): PublishStarterDeckResult!
  "スターターデッキを使用不可にする（紐づいたオペレーターだけ）"
  retireStarterDeck(
    "使用不可にするスターターデッキ"
    input: RetireStarterDeckInput!
  ): RetireStarterDeckResult!
}
