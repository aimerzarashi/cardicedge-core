# カード（Creature・Item・Spell）で共通の型。一覧の query も、ここに置く

"カード名が、ほかのカード（Creature・Item・Spell のどれか）ですでに使われている。前後の空白を除き、全角・半角の英数字などを同じ文字とみなして比べる"
type CardNameAlreadyInUseError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"カードが無い（公開用の ID に当たるカードが無い。カードでない ID を含む）"
type CardNotFoundError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"準備中のカードを使用不可にしようとした（準備中から移れるのは公開中だけ）"
type InvalidCardStatusTransitionError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"カード（Creature・Item・Spell）。種類は __typename で見分け、種類ごとの項目は断片（... on Creature 等）で取る"
interface Card {
  "公開用の ID"
  id: UUID!
  "カード名"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: CardStatus!
  "使うのに払う魔力（0 以上）"
  cost: Int!
  "希少度"
  rarity: CardRarity!
  "更新の番号（画面が見ていた版。公開する・使用不可にする操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

# 準備中から使用不可へ直接は移れない。公開中にもう一度公開する・使用不可にもう一度使用不可にするのは、変わらない操作として成功する
"""
カードの状態。準備中は自由に変えられ、デッキに入れられず、game に写さない。公開中はデッキに入れられ、game に写す。
使用不可は新しくデッキに入れられないが、プレイヤーが持っているので game には写す
"""
enum CardStatus {
  "準備中（登録したときの状態）"
  DRAFT
  "公開中"
  PUBLISHED
  "使用不可"
  RETIRED
}

# デッキ（プリセットデッキ・配布デッキ等）の中身はどれも同じ形なので、型を 1 つにする（core#25）
"デッキに入れたカードと枚数"
type DeckCard {
  "カード"
  card: Card!
  "枚数（1〜4）"
  count: Int!
}

# デッキ（プリセットデッキ・配布デッキ）の枚数を変える入力の 1 件も同じ形なので、型を 1 つにする（core#42）
"変えるカードと、その枚数"
input DeckCardCountInput {
  "カード（Creature・Item・Spell）の公開用の ID"
  cardId: UUID!
  "その枚数にする（0〜4。0 にするとデッキから外す）"
  count: Int!
}

# 上下の順は戦利品のパックで使うときに決める（2026-11-07 オーナー）。画面の略称（N・S・R・E）は studio が作る
"カードの希少度"
enum CardRarity {
  "画面では N"
  NORMAL
  "画面では S"
  STRANGE
  "画面では R"
  RARE
  "画面では E"
  EXTRA
}

"準備中でないカードの性能を変えようとした（性能を変えられるのは準備中だけ。公開中・使用不可は、デッキに入れた・game に写した性能が途中で変わるため）"
type CardNotDraftError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"カードの種類（一覧の絞り込みに使う）"
enum CardType {
  CREATURE
  ITEM
  SPELL
}

"カードの一覧の絞り込み"
input CardFilter {
  "名前に含まれる文字（前後の空白を除き、全角・半角、大文字・小文字の違いは無視する。空・空白だけは入力の誤り。50 文字まで）"
  nameContains: String
  "種類（指定が無ければすべて。空のリストは入力の誤り）"
  types: [CardType!]
  "状態（指定が無ければすべて。空のリストは入力の誤り）"
  statuses: [CardStatus!]
}

"カードの一覧の 1 件と、その位置"
type CardEdge {
  "この 1 件の位置（次のページを取るときに after に渡す）"
  cursor: String!
  "カード"
  node: Card!
}

"カードの一覧の 1 ページ（種類の順（Creature → Item → Spell）、同じ種類の中は名前の順）"
type CardConnection {
  "このページのカード"
  edges: [CardEdge!]!
  "ページの情報"
  pageInfo: PageInfo!
}

"カードの一覧の結果"
union CardsResult = CardConnection | ValidationErrors | ForbiddenError

# 種類ごとの型を union に並べる（interface の Card は union に入れられないため）
"カードの詳細の結果"
union CardResult = Creature | Item | Spell | CardNotFoundError | ForbiddenError

extend type Query {
  "カードの詳細（紐づいたオペレーターだけ。性能を変える画面が使う）"
  card(
    "カード（Creature・Item・Spell）の公開用の ID"
    id: UUID!
  ): CardResult!
  "カードの一覧（紐づいたオペレーターだけ）"
  cards(
    "絞り込み"
    filter: CardFilter
    "1 ページの件数（1〜100。指定が無ければ 50）"
    first: Int
    "前のページの pageInfo.endCursor（指定が無ければ最初のページ）"
    after: String
  ): CardsResult!
}


"カードを公開中にする入力"
input PublishCardInput {
  "カード（Creature・Item・Spell）の公開用の ID"
  id: UUID!
  "画面が見ていたカードの revision"
  revision: Int!
}

# 変える操作の結果は、公開 ID と新しい revision だけにする（core#24）
"カードを公開中にした（すでに公開中なら何も変えず、revision も進まない）"
type PublishCardSuccess {
  "公開したカードの公開用の ID"
  id: UUID!
  "公開したカードの revision（内容は返さない。画面はカードを読み直し、その revision を持つ）"
  revision: Int!
}

"カードを公開中にする操作の結果"
union PublishCardResult = PublishCardSuccess | CardNotFoundError | RevisionConflictError | InvalidCardStatusTransitionError | ForbiddenError

"カードを使用不可にする入力"
input RetireCardInput {
  "カード（Creature・Item・Spell）の公開用の ID"
  id: UUID!
  "画面が見ていたカードの revision"
  revision: Int!
}

"カードを使用不可にした（すでに使用不可なら何も変えず、revision も進まない）"
type RetireCardSuccess {
  "使用不可にしたカードの公開用の ID"
  id: UUID!
  "使用不可にしたカードの revision（内容は返さない。画面はカードを読み直し、その revision を持つ）"
  revision: Int!
}

"カードを使用不可にする操作の結果"
union RetireCardResult = RetireCardSuccess | CardNotFoundError | RevisionConflictError | InvalidCardStatusTransitionError | ForbiddenError

"カードのコストを変える入力"
input ChangeCardCostInput {
  "カード（Creature・Item・Spell）の公開用の ID"
  id: UUID!
  "画面が見ていたカードの revision"
  revision: Int!
  "変えた後のコスト（0 以上。上限は無い）"
  cost: Int!
}

"カードのコストを変えた（同じ値なら何も変えず、revision も進まない）"
type ChangeCardCostSuccess {
  "変えたカードの公開用の ID"
  id: UUID!
  "変えたカードの revision（内容は返さない。画面はカードを読み直し、その revision を持つ）"
  revision: Int!
}

"カードのコストを変える操作の結果"
union ChangeCardCostResult = ChangeCardCostSuccess | ValidationErrors | CardNotFoundError | RevisionConflictError | CardNotDraftError | ForbiddenError

"カードの希少度を変える入力"
input ChangeCardRarityInput {
  "カード（Creature・Item・Spell）の公開用の ID"
  id: UUID!
  "画面が見ていたカードの revision"
  revision: Int!
  "変えた後の希少度"
  rarity: CardRarity!
}

"カードの希少度を変えた（同じ値なら何も変えず、revision も進まない）"
type ChangeCardRaritySuccess {
  "変えたカードの公開用の ID"
  id: UUID!
  "変えたカードの revision（内容は返さない。画面はカードを読み直し、その revision を持つ）"
  revision: Int!
}

"カードの希少度を変える操作の結果"
union ChangeCardRarityResult = ChangeCardRaritySuccess | CardNotFoundError | RevisionConflictError | CardNotDraftError | ForbiddenError

extend type Mutation {
  "カードのコストを変える（紐づいたオペレーターだけ。準備中だけ）"
  changeCardCost(
    "変えるカードとコスト"
    input: ChangeCardCostInput!
  ): ChangeCardCostResult!
  "カードの希少度を変える（紐づいたオペレーターだけ。準備中だけ）"
  changeCardRarity(
    "変えるカードと希少度"
    input: ChangeCardRarityInput!
  ): ChangeCardRarityResult!
  "カードを公開中にする（紐づいたオペレーターだけ。準備中・使用不可から）"
  publishCard(
    "公開するカード"
    input: PublishCardInput!
  ): PublishCardResult!
  "カードを使用不可にする（紐づいたオペレーターだけ。公開中から）"
  retireCard(
    "使用不可にするカード"
    input: RetireCardInput!
  ): RetireCardResult!
}
