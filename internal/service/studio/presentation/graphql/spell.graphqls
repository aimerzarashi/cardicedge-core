"スペル（カードの種類の 1 つ）"
type Spell implements Card {
  "公開用の ID"
  id: UUID!
  "カード名（登録したときの表記。前後の空白は除く）"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: CardStatus!
  "使うのに払う魔力（0 以上）"
  cost: Int!
  "希少度"
  rarity: CardRarity!
  "効果（効果が無ければ null。効果の無いスペルは、対戦で使えない）"
  effect: SpellEffect
  "更新の番号（画面が見ていた版。公開する・使用不可にする操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

"スペルを登録する入力"
input RegisterSpellInput {
  "カード名（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

"スペルを登録した"
type RegisterSpellSuccess {
  "登録したスペル"
  spell: Spell!
}

"スペルの登録の結果"
union RegisterSpellResult = RegisterSpellSuccess | ValidationErrors | CardNameAlreadyInUseError | ForbiddenError

# 効果は種類ごとに型を分ける（2026-11-10 オーナー）。種類どうしに共通の項目が無いので interface ではなく union にする
"スペルの効果（種類は __typename で見分ける）"
union SpellEffect = SpellDrawCardsEffect

"カードを引く効果（山札の先頭から引く）"
type SpellDrawCardsEffect {
  "引く枚数（1 以上）"
  count: Int!
}

# @oneOf の「ちょうど 1 つ」は変数で送られた値だと GraphQL の層が確かめないため、core が確かめて FieldInvalidFormat（effect）にする
"スペルの効果の入力（種類のどれか 1 つだけ）"
input SpellEffectInput @oneOf {
  "カードを引く"
  drawCards: SpellDrawCardsEffectInput
}

"カードを引く効果の入力"
input SpellDrawCardsEffectInput {
  "引く枚数（1 以上。上限は無い）"
  count: Int!
}

"スペルの効果を変える入力"
input ChangeSpellEffectInput {
  "スペルの公開用の ID"
  id: UUID!
  "画面が見ていたスペルの revision"
  revision: Int!
  "変えた後の効果（null なら効果なし）"
  effect: SpellEffectInput
}

"スペルの効果を変えた（同じ値なら何も変えず、revision も進まない）"
type ChangeSpellEffectSuccess {
  "変えたスペルの公開用の ID"
  id: UUID!
  "変えたスペルの revision（内容は返さない。画面はカードを読み直し、その revision を持つ）"
  revision: Int!
}

"スペルの効果を変える操作の結果（カードでない ID・スペル以外のカードの ID は CardNotFoundError）"
union ChangeSpellEffectResult = ChangeSpellEffectSuccess | ValidationErrors | CardNotFoundError | RevisionConflictError | CardNotDraftError | ForbiddenError

extend type Mutation {
  "スペルの効果を変える（紐づいたオペレーターだけ。準備中だけ）"
  changeSpellEffect(
    "変えるスペルと効果"
    input: ChangeSpellEffectInput!
  ): ChangeSpellEffectResult!
  "スペルを登録する（紐づいたオペレーターだけ）"
  registerSpell(
    "登録するスペル"
    input: RegisterSpellInput!
  ): RegisterSpellResult!
}
