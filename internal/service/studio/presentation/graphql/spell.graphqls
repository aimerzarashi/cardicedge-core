"スペル（カードの種類の 1 つ）"
type Spell implements Card {
  "公開用の ID"
  id: UUID!
  "カード名（登録したときの表記。前後の空白は除く）"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: CardStatus!
  "使うのに払う魔力（0 以上）"
  cost: Int!
  "希少度"
  rarity: CardRarity!
  "効果（効果が無ければ null。効果の無いスペルは、対戦で使えない）"
  effect: SpellEffect
  "更新の番号（画面が見ていた版。公開する・使用不可にする操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

"スペルを登録する入力"
input RegisterSpellInput {
  "カード名（1〜50 文字。前後の空白は除いて保存する）"
  name: String!
}

"スペルを登録した"
type RegisterSpellSuccess {
  "登録したスペル"
  spell: Spell!
}

"スペルの登録の結果"
union RegisterSpellResult = RegisterSpellSuccess | ValidationErrors | CardNameAlreadyInUseError | ForbiddenError

# 効果は種類ごとに型を分ける（2026-11-10 オーナー）。種類どうしに共通の項目が無いので interface ではなく union にする。
# 型の名前は XxxSpellEffect にそろえる（2026-11-13 オーナー。core#173）
"スペルの効果（種類は __typename で見分ける。スペルは使ったときに発動する）"
union SpellEffect = DrawCardsSpellEffect | GainMagicSpellEffect | MultipleDiceSpellEffect | FixedDiceSpellEffect | DamageSpellEffect

"カードを引く効果（山札の先頭から引く）"
type DrawCardsSpellEffect {
  "引く枚数（1 以上）"
  count: Int!
}

"魔力を得る効果（使った人が（周回数 + 1）× perLap の魔力を得る。周回数はその対戦で周回を終えた回数）"
type GainMagicSpellEffect {
  "周回数 1 つあたりの魔力（1 以上）"
  perLap: Int!
}

"サイコロを複数振る効果（対象のプレイヤーが振るとき、count 個を同時に振り、合計の分だけ進む。turns ターン効き続ける）"
type MultipleDiceSpellEffect {
  "振るサイコロの個数（2 以上）"
  count: Int!
  "効き続けるターン数（1 以上。かかった人が自分のターンを終えるたびに 1 減り、0 で終わる）"
  turns: Int!
}

"サイコロの目を固定する効果（対象のプレイヤーが振るとき、目は value になる。turns ターン効き続ける）"
type FixedDiceSpellEffect {
  "固定する目（1 以上）"
  value: Int!
  "効き続けるターン数（1 以上。かかった人が自分のターンを終えるたびに 1 減り、0 で終わる）"
  turns: Int!
}

"対象のクリーチャーにダメージ（今の HP から amount を引き、0 になれば破壊する）"
type DamageSpellEffect {
  "ダメージ（1 以上）"
  amount: Int!
}

# @oneOf の「ちょうど 1 つ」は変数で送られた値だと GraphQL の層が確かめないため、core が確かめて FieldInvalidFormat（effect）にする
"スペルの効果の入力（種類のどれか 1 つだけ）"
input SpellEffectInput @oneOf {
  "カードを引く"
  drawCards: DrawCardsSpellEffectInput
  "魔力を得る"
  gainMagic: GainMagicSpellEffectInput
  "サイコロを複数振る"
  multipleDice: MultipleDiceSpellEffectInput
  "サイコロの目を固定する"
  fixedDice: FixedDiceSpellEffectInput
  "対象のクリーチャーにダメージ"
  damage: DamageSpellEffectInput
}

"カードを引く効果の入力"
input DrawCardsSpellEffectInput {
  "引く枚数（1 以上。上限は無い）"
  count: Int!
}

"魔力を得る効果の入力"
input GainMagicSpellEffectInput {
  "周回数 1 つあたりの魔力（1 以上。上限は無い）"
  perLap: Int!
}

"サイコロを複数振る効果の入力"
input MultipleDiceSpellEffectInput {
  "振るサイコロの個数（2 以上。上限は無い）"
  count: Int!
  "効き続けるターン数（1 以上）"
  turns: Int!
}

"サイコロの目を固定する効果の入力"
input FixedDiceSpellEffectInput {
  "固定する目（1 以上）"
  value: Int!
  "効き続けるターン数（1 以上）"
  turns: Int!
}

"対象のクリーチャーにダメージの入力"
input DamageSpellEffectInput {
  "ダメージ（1 以上。上限は無い）"
  amount: Int!
}

"スペルの効果を変える入力"
input ChangeSpellEffectInput {
  "スペルの公開用の ID"
  id: UUID!
  "画面が見ていたスペルの revision"
  revision: Int!
  "変えた後の効果（null なら効果なし）"
  effect: SpellEffectInput
}

"スペルの効果を変えた（同じ値なら何も変えず、revision も進まない）"
type ChangeSpellEffectSuccess {
  "変えたスペルの公開用の ID"
  id: UUID!
  "変えたスペルの revision（内容は返さない。画面はカードを読み直し、その revision を持つ）"
  revision: Int!
}

"スペルの効果を変える操作の結果（カードでない ID・スペル以外のカードの ID は CardNotFoundError）"
union ChangeSpellEffectResult = ChangeSpellEffectSuccess | ValidationErrors | CardNotFoundError | RevisionConflictError | CardNotDraftError | ForbiddenError

extend type Mutation {
  "スペルの効果を変える（紐づいたオペレーターだけ。準備中だけ）"
  changeSpellEffect(
    "変えるスペルと効果"
    input: ChangeSpellEffectInput!
  ): ChangeSpellEffectResult!
  "スペルを登録する（紐づいたオペレーターだけ）"
  registerSpell(
    "登録するスペル"
    input: RegisterSpellInput!
  ): RegisterSpellResult!
}
