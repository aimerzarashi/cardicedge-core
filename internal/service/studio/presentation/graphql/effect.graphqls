# 効果はアイテムとクリーチャーで共有する（効果の型は domain の effect で共有するため。2026-11-15 オーナー。core#178）。
# 接頭辞に「Card」等を付けないのは、持ち主で括ると効果の分かれ目（戦闘で効く・ボードで効く）が名前に出ないため。分かれ目は、
# 使う画面ができたら BattleEffect 等の interface を足して表す。能力は「呼び名」でなく効果を単位にし、タイミングは効果の種類で決まる
# （2026-11-14 オーナー。core#177）。「強打」「先制」のような言葉は画面のラベルで、ここには持たない
"効果の種類"
enum EffectKind {
  "AT の増減（戦闘中、AT が決まった値だけ増減する）"
  ATTACK_MODIFIER
  "HP の増減（戦闘中、HP が決まった値だけ増減する）"
  HIT_POINTS_MODIFIER
  "AT の上書き（戦闘中、AT が最小〜最大のランダムな値になる。固定は最小と最大が同じ）"
  ATTACK_OVERRIDE
  "HP の上書き（戦闘中、HP が最小〜最大のランダムな値になる。固定は最小と最大が同じ）"
  HIT_POINTS_OVERRIDE
  "AT の倍率（制約を満たすとき、増減・上書きの後に AT に倍率を掛ける。発動したうち一番高い倍率を 1 回だけ）"
  ATTACK_MULTIPLIER
  "地形効果を無視する（相手の地形効果を無視してダメージを与える）"
  IGNORE_TERRAIN_EFFECT
  "先に攻撃する（戦闘で、先に攻撃する効果の無い相手より先に攻撃する。後に攻撃すると一緒には持てない）"
  STRIKE_FIRST
  "後に攻撃する（戦闘で、後に攻撃する効果の無い相手より後に攻撃する。先に攻撃すると一緒には持てない）"
  STRIKE_LAST
  "受けるダメージを 0 にする（制約を満たす相手から攻撃を受けたとき、ダメージが 0 になる）"
  NULLIFY_RECEIVED_DAMAGE
  "通行料の倍率（いる領地の通行料を払うときに倍率を掛ける）"
  TOLL_MULTIPLIER
  "侵略できない（手札から侵略できず、移動で他人の領地にも入れない。守ることはできる）"
  FORBID_INVASION
  "移動できない（領地コマンドで動けない）"
  FORBID_MOVEMENT
  "破壊されたら手札に戻る（選んだ破壊のとき、捨て札に入ったカードが持ち主の手札に戻る。手札が上限なら戻れない）"
  RETURN_TO_HAND_ON_DESTRUCTION
  "破壊されたら魔力を得る（選んだ破壊のとき、持ち主が額の魔力を受け取る）"
  GAIN_MAGIC_ON_DESTRUCTION
  "手札のクリーチャーをアイテムとして使える（戦闘でアイテムの代わりに、属性が合う手札のクリーチャーを 1 枚出し、そのカードの AT・HP を足す。画面のラベルは援護）"
  USE_CREATURE_AS_ITEM
}

"破壊されたときの効果が発動する破壊（対戦の 3 つの破壊のイベントと対応する）"
enum EffectDestruction {
  "戦闘で、侵略したクリーチャーとして破壊された"
  INVADING
  "戦闘で、領地を守るクリーチャーとして破壊された"
  DEFENDING
  "戦闘の外（スペルのダメージ等）で破壊された"
  BOARD
}

# 種類ごとに型を分ける。union にしないのは、値の無い効果の型に項目が 1 つは要るため、すべての効果に共通の kind を持たせて interface にする
"効果（種類ごとの型）"
interface Effect {
  "効果の種類"
  kind: EffectKind!
}

"AT の増減"
type AttackModifierEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "増減の値（負は下げる）"
  value: Int!
}

"HP の増減"
type HitPointsModifierEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "増減の値（負は下げる）"
  value: Int!
}

"AT の上書き"
type AttackOverrideEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "上書きした後の AT の最小（0 以上）"
  minimum: Int!
  "上書きした後の AT の最大（最小以上）"
  maximum: Int!
}

"HP の上書き"
type HitPointsOverrideEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "上書きした後の HP の最小（1 以上）"
  minimum: Int!
  "上書きした後の HP の最大（最小以上）"
  maximum: Int!
}

"AT の倍率"
type AttackMultiplierEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "倍率（百分率。150 で 1.5 倍。1 以上）"
  percent: Int!
  "発動する制約（すべてを満たすときに発動する。無ければ空でいつも発動する）"
  constraints: [EffectConstraint!]!
}

"地形効果を無視する"
type IgnoreTerrainEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
}

"先に攻撃する"
type StrikeFirstEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
}

"後に攻撃する"
type StrikeLastEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
}

"受けるダメージを 0 にする"
type NullifyReceivedDamageEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "発動する制約（すべてを満たすときに発動する。無ければ空でいつも発動する）"
  constraints: [EffectConstraint!]!
}

"通行料の倍率"
type TollMultiplierEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "倍率（百分率。150 で 1.5 倍。1 以上）"
  percent: Int!
}

"侵略できない"
type ForbidInvasionEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
}

"移動できない"
type ForbidMovementEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
}

"破壊されたら手札に戻る"
type ReturnToHandOnDestructionEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "発動する破壊（侵略・守る・ボードの順。1 つ以上）"
  destructions: [EffectDestruction!]!
}

"破壊されたら魔力を得る"
type GainMagicOnDestructionEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "発動する破壊（侵略・守る・ボードの順。1 つ以上）"
  destructions: [EffectDestruction!]!
  "受け取る魔力の額（1 以上）"
  amount: Int!
}

"手札のクリーチャーをアイテムとして使える"
type UseCreatureAsItemEffect implements Effect {
  "効果の種類"
  kind: EffectKind!
  "アイテムとして使えるクリーチャーの属性（属性のどれかが合えば使える。火・地・水・風・無の順。1 つ以上。指定の無い援護はすべての属性）"
  elements: [CreatureElement!]!
}

"効果の制約の種類"
enum EffectConstraintKind {
  "相手のクリーチャーの属性（戦う相手のクリーチャーの属性のどれかが合うとき）"
  OPPONENT_CREATURE_ELEMENT
}

"効果の制約（種類ごとの型）"
interface EffectConstraint {
  "制約の種類"
  kind: EffectConstraintKind!
}

"相手のクリーチャーの属性の制約"
type OpponentCreatureElementConstraint implements EffectConstraint {
  "制約の種類"
  kind: EffectConstraintKind!
  "合えば満たす相手のクリーチャーの属性（火・地・水・風・無の順。1 つ以上）"
  elements: [CreatureElement!]!
}

# 種類と値の組み合わせが合わないものは FieldInvalidFormat（effects.N）、値の範囲の誤りは FieldTooSmall（effects.N.minimum・effects.N.percent。
# 最大が最小より小さいのは、最大は最小と等しくてよいので FieldNotGreaterThan でなく、最小を下限にした FieldTooSmall の effects.N.maximum）。
# 制約の誤りは FieldInvalidFormat（effects.N.constraints.M・effects.N.constraints.M.elements）。発動する破壊の誤り（空・重複）は
# FieldInvalidFormat（effects.N.destructions）、魔力の額の下限は FieldTooSmall（effects.N.amount）。アイテムとして使えるクリーチャーの
# 属性の誤り（空・重複）は FieldInvalidFormat（effects.N.elements）
"効果の入力（種類に要る値だけを入れる。増減は value、上書きは minimum と maximum、AT の倍率は percent と constraints、通行料の倍率は percent、受けるダメージを 0 にするは constraints、破壊されたら手札に戻るは destructions、破壊されたら魔力を得るは destructions と amount、手札のクリーチャーをアイテムとして使えるは elements）"
input EffectInput {
  "効果の種類"
  kind: EffectKind!
  "AT・HP の増減の値"
  value: Int
  "上書きした後の値の最小"
  minimum: Int
  "上書きした後の値の最大"
  maximum: Int
  "倍率（百分率）"
  percent: Int
  "制約（すべてを満たすときに発動する）"
  constraints: [EffectConstraintInput!]
  "発動する破壊（1 つ以上・重複なし）"
  destructions: [EffectDestruction!]
  "受け取る魔力の額"
  amount: Int
  "アイテムとして使えるクリーチャーの属性（1 つ以上・重複なし）"
  elements: [CreatureElement!]
}

"効果の制約の入力"
input EffectConstraintInput {
  "制約の種類"
  kind: EffectConstraintKind!
  "相手のクリーチャーの属性（1 つ以上・重複なし）"
  elements: [CreatureElement!]
}
