# studio 用の GraphQL（/studio/graphql）。studio の better-auth の JWT（Authorization: Bearer）が無いと、どの操作も受け付けない
# 機能ごとのファイルは Query・Mutation を extend する（ここでは中身の無い型だけを置く）。
# 結果は「<操作>Result = 成功の型 | エラー型」の union で返す（未認証は union に含めず HTTP 401）。成功の型は、ミューテーションは
# <操作>Success で包み、クエリは問い合わせたもの（1 件なら対象の型、一覧なら 1 ページの XxxConnection）を入れる（core#35）。
# 認可（オペレーターでない）は ForbiddenError、入力の誤りは ValidationErrors を union に含めて返す

# ログイン中のオペレーターを返す me は、使う場面が出てくるまで作らない（core#7）。core の版は HTTP の /version で返す
# （GraphQL の version は、Query が 1 つ以上要るために置いていたが、ほかのクエリができたため消した。core#35）
type Query

type Mutation

"公開用の ID（UUID の文字列）。core の内部の ID は返さない"
scalar UUID

"日時（RFC 3339 の文字列。例: 2026-10-17T09:00:00Z）"
scalar DateTime

"操作する権限が無い（JWT は正しいが、core のオペレーターとして登録されていない等）"
type ForbiddenError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

# 入力の誤り。理由ごとに型を分け、その理由に要る値だけを必須で持つ（理由によって null になる項目を作らないため）。
# 文言は返さない（言い回し・項目の呼び方は画面の都合なので、studio が __typename と値から作る）
"入力の項目ごとの誤り。理由は __typename で見分ける"
interface FieldError {
  "誤りのある入力の項目（GraphQL の引数・入力の項目名と同じ。入れ子の入力は filter.nameContains、一覧の中は cards.0.cardId のように . でつなぐ）"
  field: String!
}

"入力が空（前後の空白だけの場合を含む）"
type FieldRequired implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力が長すぎる"
type FieldTooLong implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "上限の文字数"
  max: Int!
}

"入力が範囲の外"
type FieldOutOfRange implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "範囲の下限（この値を含む）"
  min: Int!
  "範囲の上限（この値を含む）"
  max: Int!
}

# 上限の無い値の下限。上限のある値の FieldOutOfRange は max が必須で、上限の無い値には使えない
"入力が下限より小さい（上限は無い）"
type FieldTooSmall implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "下限（この値を含む）"
  min: Int!
}

# 下限が相手の項目の値で決まるので、数ではなく相手の項目の名前を返す。画面は相手の項目の入力中の値で文言を作る
"入力が、別の入力の項目の値より大きくない（等しいのも含む。例: 目標の魔力が開始時の魔力以下、サイコロの目の最大が最小以下）"
type FieldNotGreaterThan implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "大きくなければならない相手の入力の項目（例: startingMagic）"
  than: String!
}

"入力の形が正しくない（メールアドレスとして読めない、ページの位置（カーソル）が読めない等）"
type FieldInvalidFormat implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力の ID が指すもの（プリセットデッキに入れるカード等）が無い"
type FieldNotFound implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力の ID が指すものが、使えない状態（準備中・使用不可のカード等）。あるが、今の状態では使えない"
type FieldUnavailable implements FieldError {
  "誤りのある入力の項目（一覧の中の位置を含む。例: cards.2.cardId）"
  field: String!
}

"一覧の中で、同じもの（同じカード等）がすでに出てきた（2 回目に付ける）"
type FieldDuplicated implements FieldError {
  "誤りのある入力の項目（一覧の中の位置を含む。例: cards.2.cardId）"
  field: String!
}

"つながりの両端が隣どうし（上下左右に 1 マス）でない（同じ座標を指すものを含む）"
type FieldNotAdjacent implements FieldError {
  "誤りのある入力の項目（一覧の中の位置を含む。例: connections.2）"
  field: String!
}

"対の端のマスが、転送円でも橋でもない"
type FieldNotPairable implements FieldError {
  "誤りのある入力の項目（一覧の中の位置と端を含む。例: pairs.2.a）"
  field: String!
}

"対の両端が、転送円と橋（組めるのは同じ種類どうしだけ）"
type FieldPairKindMismatch implements FieldError {
  "誤りのある入力の項目（一覧の中の位置を含む。例: pairs.2）"
  field: String!
}

"対の両端が同じ座標（自分自身と組んでいる）"
type FieldPairedWithSelf implements FieldError {
  "誤りのある入力の項目（一覧の中の位置を含む。例: pairs.2）"
  field: String!
}

"入力を当てた後の合計（プリセットデッキのカードの枚数の合計等）が上限を超える（入力の値そのものではなく、今の状態と合わせた結果の誤り）"
type FieldTotalTooLarge implements FieldError {
  "誤りのある入力の項目（一覧全体の結果のときは一覧の項目名。例: cards）"
  field: String!
  "合計の上限"
  max: Int!
}

"合計がちょうど決まった値でない（公開する配布デッキの枚数の合計等。多すぎるのも足りないのも同じ理由）"
type FieldTotalMismatch implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "合計の決まった値"
  required: Int!
}

"入力の誤り（操作は行われていない）"
type ValidationErrors {
  "項目ごとの誤り（1 件以上）"
  errors: [FieldError!]!
}

# 一覧のページ分けは、Relay の決まり（Connection）の形にし、順方向（first・after）だけにする（core#12）
"ページの情報"
type PageInfo {
  "次のページがあるか"
  hasNextPage: Boolean!
  "前のページがあるか（after を指定したら true）"
  hasPreviousPage: Boolean!
  "このページの最初の 1 件の位置"
  startCursor: String
  "このページの最後の 1 件の位置（次のページは after にこれを渡す）"
  endCursor: String
}

# 画面で見た内容をもとに、既にあるものを変える・消す操作は、入力に revision（画面が見ていた版）を含め、
# 今の版と違えばこの型を返す（core#24。流れは internal/eventstore/README.md）。今の revision は持たせない（読み直さずに送り直せてしまうため）
"先に変えられた（画面を開いた後に、ほかの操作でこの対象が変わった。操作は行われていない）。読み直してから操作し直す"
type RevisionConflictError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}
