# NPC のアバター（対戦の相手になるコンピューターのキャラクター。1 アバター 1 集約。core#61）。今は名前と状態だけを持ち、
# 見た目・説明・強さは後で足す。NPC のデッキは別の集約で、結びつけない。準備中のあいだだけ名前を変えられ、削除できる

"NPC のアバター"
type NpcAvatar {
  "公開用の ID"
  id: UUID!
  "名前（登録・変更したときの表記。前後の空白は除く。状態によらず、すべての NPC のアバターの中で一意）"
  name: String!
  "状態（準備中・公開中・使用不可）"
  status: NpcAvatarStatus!
  "更新の番号（画面が見ていた版。変える・消す操作の入力にそのまま渡す。利用者には見せない）"
  revision: Int!
  "登録した日時"
  registeredAt: DateTime!
  "最後に変更した日時（変更していなければ登録した日時）"
  updatedAt: DateTime!
}

# 準備中から使用不可へ直接は移れず、公開中から準備中へも戻れない。公開中にもう一度公開する・使用不可にもう一度使用不可にするのは、
# 変わらない操作として成功する（ボードと同じ）
"""
NPC のアバターの状態。準備中は名前を自由に変えられる。公開中の数に上限は無く、公開の条件も無い。
使用不可は新しい対戦に使わない
"""
enum NpcAvatarStatus {
  "準備中（登録したときの状態）"
  DRAFT
  "公開中"
  PUBLISHED
  "使用不可"
  RETIRED
}

"名前が、ほかの NPC のアバターですでに使われている（状態によらない）。カード名と同じ比べ方（前後の空白を除き、全角・半角、大文字・小文字の違いを同じとみなす）"
type NpcAvatarNameAlreadyInUseError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"NPC のアバターが無い（削除したものを含む）"
type NpcAvatarNotFoundError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"準備中の NPC のアバターを使用不可にしようとした（準備中から移れるのは公開中だけ）"
type InvalidNpcAvatarStatusTransitionError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"準備中でない NPC のアバターの名前を変える、または削除しようとした（準備中のものだけ変えられる）"
type NpcAvatarNotDraftError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"NPC のアバターの一覧の絞り込み"
input NpcAvatarFilter {
  "名前に含まれる文字（前後の空白を除き、全角・半角、大文字・小文字の違いは無視する。空・空白だけは入力の誤り。50 文字まで）"
  nameContains: String
  "状態（指定が無ければすべて。空のリストは入力の誤り）"
  statuses: [NpcAvatarStatus!]
}

"NPC のアバターの一覧の 1 件と、その位置"
type NpcAvatarEdge {
  "この 1 件の位置（次のページを取るときに after に渡す）"
  cursor: String!
  "NPC のアバター"
  node: NpcAvatar!
}

"NPC のアバターの一覧の 1 ページ（名前の順）"
type NpcAvatarConnection {
  "このページの NPC のアバター"
  edges: [NpcAvatarEdge!]!
  "ページの情報"
  pageInfo: PageInfo!
}

"NPC のアバターの一覧の結果"
union NpcAvatarsResult = NpcAvatarConnection | ValidationErrors | ForbiddenError

"NPC のアバターの詳細の結果"
union NpcAvatarResult = NpcAvatar | NpcAvatarNotFoundError | ForbiddenError

extend type Query {
  "NPC のアバターの一覧（紐づいたオペレーターだけ）"
  npcAvatars(
    "絞り込み"
    filter: NpcAvatarFilter
    "1 ページの件数（1〜100。指定が無ければ 50）"
    first: Int
    "前のページの pageInfo.endCursor（指定が無ければ最初のページ）"
    after: String
  ): NpcAvatarsResult!
  "NPC のアバターの詳細（紐づいたオペレーターだけ）"
  npcAvatar(
    "NPC のアバターの公開用の ID"
    id: UUID!
  ): NpcAvatarResult!
}

"NPC のアバターを登録する入力"
input RegisterNpcAvatarInput {
  "名前（1〜20 文字。前後の空白は除いて保存する）"
  name: String!
}

# 変える操作の結果は、公開 ID と新しい revision だけにする（PresetDeck と同じ）
"NPC のアバターを登録した（準備中）"
type RegisterNpcAvatarSuccess {
  "登録した NPC のアバターの公開用の ID"
  id: UUID!
  "登録した NPC のアバターの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"NPC のアバターの登録の結果"
union RegisterNpcAvatarResult = RegisterNpcAvatarSuccess | ValidationErrors | NpcAvatarNameAlreadyInUseError | ForbiddenError

"NPC のアバターの名前を変える入力"
input RenameNpcAvatarInput {
  "NPC のアバターの公開用の ID"
  id: UUID!
  "画面が見ていた NPC のアバターの revision"
  revision: Int!
  "新しい名前（1〜20 文字。前後の空白は除いて保存する）"
  name: String!
}

"NPC のアバターの名前を変えた（同じ名前なら何も変えず、revision も進まない）"
type RenameNpcAvatarSuccess {
  "変えた NPC のアバターの公開用の ID"
  id: UUID!
  "変えた NPC のアバターの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"NPC のアバターの名前の変更の結果（準備中のものだけ変えられる）"
union RenameNpcAvatarResult =
    RenameNpcAvatarSuccess
  | ValidationErrors
  | NpcAvatarNotFoundError
  | NpcAvatarNameAlreadyInUseError
  | NpcAvatarNotDraftError
  | RevisionConflictError
  | ForbiddenError

"NPC のアバターを削除する入力"
input DeleteNpcAvatarInput {
  "NPC のアバターの公開用の ID"
  id: UUID!
  "画面が見ていた NPC のアバターの revision"
  revision: Int!
}

"NPC のアバターを削除した（名前はほかの NPC のアバターが使えるようになる）"
type DeleteNpcAvatarSuccess {
  "削除した NPC のアバターの公開用の ID"
  id: UUID!
}

"NPC のアバターの削除の結果（準備中のものだけ消せる）"
union DeleteNpcAvatarResult =
    DeleteNpcAvatarSuccess
  | NpcAvatarNotFoundError
  | NpcAvatarNotDraftError
  | RevisionConflictError
  | ForbiddenError

"NPC のアバターを公開する入力"
input PublishNpcAvatarInput {
  "NPC のアバターの公開用の ID"
  id: UUID!
  "画面が見ていた NPC のアバターの revision"
  revision: Int!
}

"NPC のアバターを公開中にした（すでに公開中なら何も変えず、revision も進まない）"
type PublishNpcAvatarSuccess {
  "公開した NPC のアバターの公開用の ID"
  id: UUID!
  "公開した NPC のアバターの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"NPC のアバターの公開の結果（準備中・使用不可から公開中にできる。公開の条件は無い）"
union PublishNpcAvatarResult =
    PublishNpcAvatarSuccess
  | NpcAvatarNotFoundError
  | RevisionConflictError
  | ForbiddenError

"NPC のアバターを使用不可にする入力"
input RetireNpcAvatarInput {
  "NPC のアバターの公開用の ID"
  id: UUID!
  "画面が見ていた NPC のアバターの revision"
  revision: Int!
}

"NPC のアバターを使用不可にした（すでに使用不可なら何も変えず、revision も進まない）"
type RetireNpcAvatarSuccess {
  "使用不可にした NPC のアバターの公開用の ID"
  id: UUID!
  "使用不可にした NPC のアバターの revision（内容は返さない。画面は詳細を読み直し、詳細の revision を持つ）"
  revision: Int!
}

"NPC のアバターの使用不可の結果"
union RetireNpcAvatarResult =
    RetireNpcAvatarSuccess
  | NpcAvatarNotFoundError
  | InvalidNpcAvatarStatusTransitionError
  | RevisionConflictError
  | ForbiddenError

extend type Mutation {
  "NPC のアバターを登録する（準備中。紐づいたオペレーターだけ）"
  registerNpcAvatar(
    "登録する NPC のアバター"
    input: RegisterNpcAvatarInput!
  ): RegisterNpcAvatarResult!
  "NPC のアバターの名前を変える（準備中のものだけ。紐づいたオペレーターだけ）"
  renameNpcAvatar(
    "変える内容"
    input: RenameNpcAvatarInput!
  ): RenameNpcAvatarResult!
  "NPC のアバターを削除する（準備中のものだけ。紐づいたオペレーターだけ）"
  deleteNpcAvatar(
    "削除する NPC のアバター"
    input: DeleteNpcAvatarInput!
  ): DeleteNpcAvatarResult!
  "NPC のアバターを公開中にする（紐づいたオペレーターだけ）"
  publishNpcAvatar(
    "公開する NPC のアバター"
    input: PublishNpcAvatarInput!
  ): PublishNpcAvatarResult!
  "NPC のアバターを使用不可にする（紐づいたオペレーターだけ）"
  retireNpcAvatar(
    "使用不可にする NPC のアバター"
    input: RetireNpcAvatarInput!
  ): RetireNpcAvatarResult!
}
