# game 用の GraphQL（/game/graphql）。game の better-auth の JWT（Authorization: Bearer）が無いと、どの操作も受け付けない
# 機能ごとのファイルは Query・Mutation を extend する（studio の common.graphqls と同じ形にする）。
# 結果は「<操作>Result = 成功の型 | エラー型」の union で返す（未認証は union に含めず HTTP 401）。成功の型は、ミューテーションは
# <操作>Success で包み、クエリは問い合わせたもの（1 件なら対象の型、一覧なら 1 ページの XxxConnection）を入れる（core#35）

type Query

type Mutation

type Subscription

"公開用の ID（UUID の文字列）。core の内部の ID は返さない"
scalar UUID

"日時（RFC 3339 の文字列。例: 2026-10-17T09:00:00Z）"
scalar DateTime

# 入力の誤り。理由ごとに型を分け、その理由に要る値だけを必須で持つ（理由によって null になる項目を作らないため）。
# 文言は返さない（言い回し・項目の呼び方は画面の都合なので、game が __typename と値から作る）
"入力の項目ごとの誤り。理由は __typename で見分ける"
interface FieldError {
  "誤りのある入力の項目（GraphQL の引数・入力の項目名と同じ。入れ子の入力は filter.nameContains、一覧の中は cards.0.cardId のように . でつなぐ）"
  field: String!
}

"入力が空（前後の空白だけの場合を含む）"
type FieldRequired implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力が長すぎる"
type FieldTooLong implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "上限の文字数"
  max: Int!
}

"入力が範囲の外"
type FieldOutOfRange implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "範囲の下限（この値を含む）"
  min: Int!
  "範囲の上限（この値を含む）"
  max: Int!
}

# 上限の無い値の下限。上限のある値の FieldOutOfRange は max が必須で、上限の無い値には使えない
"入力が下限より小さい（上限は無い）"
type FieldTooSmall implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "下限（この値を含む）"
  min: Int!
}

# 下限が相手の項目の値で決まるので、数ではなく相手の項目の名前を返す。画面は相手の項目の入力中の値で文言を作る
"入力が、別の入力の項目の値より大きくない（等しいのも含む。例: 目標の魔力が開始時の魔力以下、サイコロの目の最大が最小以下）"
type FieldNotGreaterThan implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "大きくなければならない相手の入力の項目（例: startingMagic）"
  than: String!
}

# 無い・ほかのプレイヤーのもの・解放していない・公開中でない等を区別しないのは、存在を明かさないため
"入力の ID が指すものが、選べるものの中に無い（無い・ほかのプレイヤーのもの・解放していない・公開中でない等。区別しない）"
type FieldNotFound implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力の一覧の中の、ある種類の個数が上限より多い（例: 部屋のプレイヤーの席）"
type FieldTooMany implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "上限の個数"
  max: Int!
}

"入力の形が正しくない（ページの位置（カーソル）が読めない等）"
type FieldInvalidFormat implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力の誤り（操作は行われていない）"
type ValidationErrors {
  "項目ごとの誤り（1 件以上）"
  errors: [FieldError!]!
}

# 一覧のページ分けは、Relay の決まり（Connection）の形にし、順方向（first・after）だけにする（studio と同じ。core#12）
"ページの情報"
type PageInfo {
  "次のページがあるか"
  hasNextPage: Boolean!
  "前のページがあるか（after を指定したら true）"
  hasPreviousPage: Boolean!
  "このページの最初の 1 件の位置"
  startCursor: String
  "このページの最後の 1 件の位置（次のページは after にこれを渡す）"
  endCursor: String
}

# 画面で見た内容をもとに、既にあるものを変える操作は、入力に revision（画面が見ていた版）を含め、今の版と違えばこの型を返す
# （studio と同じ。流れは internal/eventstore/README.md）。今の revision は持たせない（読み直さずに送り直せてしまうため）
"先に変えられた（画面を開いた後に、ほかの操作でこの対象が変わった。操作は行われていない）。読み直してから操作し直す"
type RevisionConflictError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}
