  id: UUID!
  "操作した後の対戦の revision"
  revision: Int!
}

"endMatchTurn の結果（ENDING と PLACING の段階の（PLACING では配置しないことになる）、今の番の参加者だけ。番でなければ MatchNotYourTurnError、段階が違えば MatchPhaseNotAllowedError。参加していない対戦は MatchNotFoundError）"
union EndMatchTurnResult =
