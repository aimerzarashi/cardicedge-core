}

"ターンを終える（成功したら対戦の revision が進む）"
type EndMatchTurnSuccess {
  "対戦の公開用の ID"
  id: UUID!
  "操作した後の対戦の revision"
  revision: Int!
}

"endMatchTurn の結果（ENDING と DEPLOYING の段階の（DEPLOYING では配置しないことになる）、今の番の参加者だけ。番でなければ MatchNotYourTurnError、段階が違えば MatchPhaseNotAllowedError。参加していない対戦は MatchNotFoundError）"
union EndMatchTurnResult =
    EndMatchTurnSuccess
  | MatchNotFoundError
  | MatchNotYourTurnError
  | MatchPhaseNotAllowedError
  | RevisionConflictError
  | PlayerNotRegisteredError

"戦利品のパックを選ぶ入力"
input ChooseMatchRewardPackInput {
  "対戦の公開用の ID"
  id: UUID!
  "画面が見ていた対戦の revision"
  revision: Int!
  "選ぶパックのキー（Match.rewardPacks の中から選ぶ。選べないものは ValidationErrors の FieldNotFound）"
  pack: String!
}

"戦利品のパックを選んでカードを引いた（成功したら対戦の revision が進む。カードは Match.participants の rewardCards で読み、所持品へはポリシーが足す）"
type ChooseMatchRewardPackSuccess {
  "対戦の公開用の ID"
  id: UUID!
  "操作した後の対戦の revision"
  revision: Int!
}

"戦利品はもう受け取った"
type MatchRewardAlreadyReceivedError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"chooseMatchRewardPack の結果（ENDED の段階の、まだ受け取っていないプレイヤーだけ。番は問わない。終わっていなければ MatchPhaseNotAllowedError、受け取り済みなら MatchRewardAlreadyReceivedError。参加していない対戦は MatchNotFoundError）"
union ChooseMatchRewardPackResult =
    ChooseMatchRewardPackSuccess
  | ValidationErrors
  | MatchNotFoundError
  | MatchPhaseNotAllowedError
  | MatchRewardAlreadyReceivedError
  | RevisionConflictError
  | PlayerNotRegisteredError

extend type Mutation {
  "カードを引く"
  drawMatchCard(input: DrawMatchCardInput!): DrawMatchCardResult!
  "手札を 1 枚捨てる"
  discardMatchCard(input: DiscardMatchCardInput!): DiscardMatchCardResult!
  "サイコロを振る"
  rollMatchDice(input: RollMatchDiceInput!): RollMatchDiceResult!
  "分かれ道で行き先を選ぶ"
  chooseMatchPath(input: ChooseMatchPathInput!): ChooseMatchPathResult!
  "止まった空き地に、手札のクリーチャーを配置する（配置したらターンを終える）"
  deployMatchCreature(input: DeployMatchCreatureInput!): DeployMatchCreatureResult!
  "魔力が負の間に、自分の領地を手放す"
  relinquishMatchTerritory(input: RelinquishMatchTerritoryInput!): RelinquishMatchTerritoryResult!
  "通った自分の領地のレベルを上げる（領地コマンド。他人の領地に止まっていれば続けて通行料を払い、ほかはターンを終える）"
  levelUpMatchTerritory(input: LevelUpMatchTerritoryInput!): LevelUpMatchTerritoryResult!
  "通った自分の領地のクリーチャーを手札のクリーチャーと交換する（領地コマンド。他人の領地に止まっていれば続けて通行料を払い、ほかはターンを終える）"
  exchangeMatchCreature(input: ExchangeMatchCreatureInput!): ExchangeMatchCreatureResult!
  "通った自分の領地のクリーチャーを動かす（領地コマンド。空き地へならそのまま止まったマスの決まりに進み、他人の領地へなら侵略と同じ戦闘をする）"
  moveMatchCreature(input: MoveMatchCreatureInput!): MoveMatchCreatureResult!
  "通った自分の領地の土地の属性を変える（領地コマンド。他人の領地に止まっていれば続けて通行料を払い、ほかはターンを終える）"
  changeMatchLandElement(input: ChangeMatchLandElementInput!): ChangeMatchLandElementResult!
  "止まった他人の領地を、手札のクリーチャーで侵略する（選んだ時点で確定し、コストの分の魔力を払う）"
  invadeMatchTerritory(input: InvadeMatchTerritoryInput!): InvadeMatchTerritoryResult!
  "侵略を確定した人が、アイテムを選ぶ（出さないことも選ぶ）"
  attackMatchTerritory(input: AttackMatchTerritoryInput!): AttackMatchTerritoryResult!
  "止まった他人の領地の通行料を払う"
  payMatchToll(input: PayMatchTollInput!): PayMatchTollResult!
  "侵略された領地の持ち主が、アイテムを選んで戦闘に進める（出さないことも選ぶ）"
  defendMatchTerritory(input: DefendMatchTerritoryInput!): DefendMatchTerritoryResult!
  "ターンを終える（DEPLOYING では配置しない）"
  endMatchTurn(input: EndMatchTurnInput!): EndMatchTurnResult!
  "終わった後に、戦利品のパックを選ぶ（順位の枚数のカードを引く）"
  chooseMatchRewardPack(input: ChooseMatchRewardPackInput!): ChooseMatchRewardPackResult!
}

"""
対戦の進み。画面は手元の版（revision）と比べ、進んでいれば matchEvents で差分を、match で今の状態を読む。
版だけを送るのは、見せてよいものの絞り込みを query の側だけで行うため
"""
type MatchProgress {
  "対戦の公開用の ID"
  id: UUID!
  "対戦の最新の版（Match.revision と同じ。抜けなく 1 から続く）"
  revision: Int!
  "その版のイベントの起きた時刻"
  occurredAt: DateTime!
}

"対戦の進みの結果。ログイン中のプレイヤーが未登録なら PlayerNotRegisteredError"
union MatchProgressResult = MatchProgress | MatchNotFoundError | PlayerNotRegisteredError

extend type Subscription {
  """
  自分が参加している対戦の進み（登録済みのプレイヤーだけ）。つないだ直後に今の版を送り、版が進んだらすぐ、
  変わらなくても数秒ごとに送る（つながっていることの確認も兼ねる）。全員が戦利品を受け取り終えたら、その版を送ってから閉じる
  （対戦が終わっただけでは閉じない。受け取らないまま離れた人がいると閉じない）。
  無い・参加していない対戦は MatchNotFoundError を 1 回送って閉じる。SSE（graphql-sse）でつなぐ
  """
  matchProgress(
    "対戦の公開用の ID"
    id: UUID!
  ): MatchProgressResult!
}

"領地の価値と通行料"
type MatchTerritoryValue {
  "領地の位置"
  position: BoardPosition!
  "土地の価値（連鎖を含む）"
  value: Int!
  "他人が止まったときに払う通行料"
  toll: Int!
}

"総魔力が変わった参加者"
type MatchTotalMagicChange {
  "参加者（Match.participants の何番目か）"
  participant: Int!
  "変わった後の総魔力"
  totalMagic: Int!
}

"""
このイベントで変わった、描画に要る値のうち、イベントの事実からは出せず core の決まりで決まるもの。
画面がイベントの再生で描くときに、計算せずに当てられるように返す。
保存するイベントの payload には持たない（読むときにイベントを順に当てて計算する）
"""
type MatchEventChanges {
  "このイベントの後の段階。操作を待っていない間（始まる前・移動の途中）は null"
  phase: MatchPhase
  "総魔力が変わった参加者だけ"
  totalMagics: [MatchTotalMagicChange!]!
  "価値か通行料が変わった領地だけ（できた順。無くなった領地は入らない）"
  territoryValues: [MatchTerritoryValue!]!
}

"""
対戦のイベント。種類ごとの型で見せ、見せないもの（山札の並び）は項目を持たない。
誰が（participant）は Match.participants の何番目か
"""
interface MatchEvent {
  "対戦の版（このイベントまで進んだ版。抜けなく 1 から続く）"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"対戦が始まった（参加者・盤面・ルールは match で読む）"
type MatchCreatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"順番が決まった"
type MatchTurnOrderDecidedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "参加者の番号（Match.participants の何番目か）を、順番の早い順に並べたもの"
  order: [Int!]!
}

"山札が混ざった（並びは見せないので、項目を持たない）"
type MatchDecksShuffledEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"全員に手札が配られた"
type MatchHandsDealtEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "全員に配った枚数（山札が足りなければ、ある分だけ）"
  cards: Int!
}

"カードを引いた"
type MatchCardDrawnEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "引いた参加者（Match.participants の何番目か）"
  participant: Int!
  "引いたカード"
  card: CardInfo!
}

"手札を 1 枚捨てた"
type MatchCardDiscardedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "捨てた参加者（Match.participants の何番目か）"
  participant: Int!
  "捨てた手札の番号（0 始まり）"
  handIndex: Int!
  "捨てたカード"
  card: CardInfo!
}

"止まった空き地に、手札のクリーチャーを配置した（そのままターンを終える）"
type MatchCreatureDeployedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "配置した参加者（Match.participants の何番目か）"
  participant: Int!
  "配置した手札の番号（0 始まり）"
  handIndex: Int!
  "配置したカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "配置したクリーチャーの ID（Match.territories の creature.id と同じ番号）"
  creature: Int!
  "配置した位置（領地になった）"
  position: BoardPosition!
  "払った魔力"
  cost: Int!
}

"止まった他人の領地を、手札のクリーチャーで侵略した"
type MatchTerritoryInvadedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "侵略した参加者（Match.participants の何番目か）"
  participant: Int!
  "出した手札の番号（0 始まり）"
  handIndex: Int!
  "出したカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "侵略した領地の位置"
  position: BoardPosition!
  "払った魔力"
  cost: Int!
}

"戦闘に手札のアイテムを出した（攻める側も守る側も同じ。効果はまだ無い）"
type MatchItemUsedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "出した参加者（Match.participants の何番目か）"
  participant: Int!
  "出した手札の番号（0 始まり）"
  handIndex: Int!
  "出したカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "払った魔力"
  cost: Int!
}

"戦闘にアイテムを出さなかった（攻める側も守る側も同じ）"
type MatchItemSkippedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "出さなかった参加者（Match.participants の何番目か）"
  participant: Int!
}

"戦闘のどちら側か"
enum MatchBattleSide {
  "攻める側（侵略した側）"
  ATTACKER
  "守る側（領地の持ち主）"
  DEFENDER
}

"通った自分の領地のレベルを上げた"
type MatchTerritoryLeveledUpEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "上げた参加者（Match.participants の何番目か）"
  participant: Int!
  "領地の位置"
  position: BoardPosition!
  "上げた後のレベル"
  level: Int!
  "払った魔力"
  magic: Int!
}

"通った自分の領地のクリーチャーを空き地へ動かした（行き先が領地になり、元の土地は空き地になる。土地のレベルはどちらも土地に残る）"
type MatchCreatureMovedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "動かした参加者（Match.participants の何番目か）"
  participant: Int!
  "元の領地の位置"
  from: BoardPosition!
  "行き先"
  to: BoardPosition!
  "動いたクリーチャーの ID（同じ 1 体のまま）"
  creature: Int!
}

"通った自分の領地のクリーチャーを他人の領地へ動かし、侵略した（続けてアイテムを選び、戦闘する）"
type MatchTerritoryInvadedByMoveEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "動かした参加者（Match.participants の何番目か）"
  participant: Int!
  "元の領地の位置"
  from: BoardPosition!
  "攻める領地の位置"
  position: BoardPosition!
  "動いたクリーチャーの ID"
  creature: Int!
}

"通った自分の領地の土地の属性を変えた（土地のレベルとクリーチャーはそのまま）"
type MatchLandElementChangedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "変えた参加者（Match.participants の何番目か）"
  participant: Int!
  "領地の位置"
  position: BoardPosition!
  "変えた後の属性"
  element: BoardTileElement!
  "払った魔力"
  magic: Int!
}

"領地のクリーチャーを手札のクリーチャーと入れ替えた"
type MatchCreatureExchangedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "交換した参加者（Match.participants の何番目か）"
  participant: Int!
  "領地の位置"
  position: BoardPosition!
  "出した手札の番号（0 始まり）"
  handIndex: Int!
  "領地に入ったカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "領地に入ったクリーチャーの新しい ID（Match.territories の creature.id と同じ番号）"
  creature: Int!
  "払った魔力"
  cost: Int!
  "手札の最後に戻ったカード（性能は対戦を始めたときの写し）"
  returnedCard: CardInfo!
}

"戦闘の中の AT・HP"
type MatchBattleStats {
  "攻撃力"
  attack: Int!
  "体力"
  hitPoints: Int!
}

"戦闘が始まった（効果を当てる前の両方の AT・HP）"
type MatchBattleStartedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "攻める側"
  attacker: MatchBattleStats!
  "守る側"
  defender: MatchBattleStats!
}

"支援（侵略先の隣にある、攻める側の領地）"
type MatchAdjacentTerritoriesSource {
  "隣の領地の位置"
  positions: [BoardPosition!]!
}

"地形効果（効いた土地）"
type MatchTerrainSource {
  "土地の属性"
  element: BoardTileElement!
  "土地のレベル"
  level: Int!
}

"戦闘に出したアイテム"
type MatchItemSource {
  "アイテムのカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
}

"戦闘の AT・HP を変えた効果の出どころ"
union MatchBattleStatSource = MatchAdjacentTerritoriesSource | MatchTerrainSource | MatchItemSource

"効果 1 つが戦闘の AT・HP を変えた"
type MatchBattleStatModifiedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "効果を受けた側"
  side: MatchBattleSide!
  "何の効果か"
  source: MatchBattleStatSource!
  "AT の増減（下限の 0 で止まった後の実際の増減）"
  attackDelta: Int!
  "HP の増減（下限の 0 で止まった後の実際の増減）"
  hitPointsDelta: Int!
  "当てた後の AT"
  attack: Int!
  "当てた後の HP（0 ならその時点で破壊され、戦闘が終わる）"
  hitPoints: Int!
}

"戦闘の攻撃が 1 回当たった"
type MatchCreatureStruckEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "攻撃した側"
  striker: MatchBattleSide!
  "与えた量"
  damage: Int!
  "受けた側の、効果で増えた分も含む残りの体力（0 なら倒れた）"
  remainingHitPoints: Int!
}

"守る側のクリーチャーを倒して土地を奪った（土地のレベルは引き継ぐ）"
type MatchTerritoryConqueredEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "奪った参加者（Match.participants の何番目か）"
  participant: Int!
  "奪った領地の位置"
  position: BoardPosition!
  "倒されて盤面から外れたクリーチャーの ID"
  defeatedCreature: Int!
  "領地に入ったクリーチャーの新しい ID（Match.territories の creature.id と同じ番号）"
  creature: Int!
  "領地に入ったクリーチャーの体力"
  territoryHitPoints: Int!
}

"守る側のクリーチャーを倒せなかった（続けて通行料を払う）"
type MatchInvasionRepelledEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "侵略した参加者（Match.participants の何番目か）"
  participant: Int!
  "侵略した領地の位置"
  position: BoardPosition!
  "攻めたカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "手札に戻ったか（生きていれば true。倒れていれば捨て札になり false）"
  returnedToHand: Boolean!
  "領地のクリーチャーに残る体力（増えた分を超えたダメージだけが傷になる）"
  territoryHitPoints: Int!
  "移動で侵略して生き残ったときだけ。戻った元の領地の位置（倒れたときは null で、元の土地は空き地になる）"
  returnedTo: BoardPosition
  "移動で侵略して生き残ったときだけ。戻ったクリーチャーの体力"
  returnedHitPoints: Int
}

"他人の領地に止まって通行料を払った（足りなくても全額を払い、魔力は負になる）"
type MatchTollPaidEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "払った参加者（Match.participants の何番目か）"
  participant: Int!
  "受け取った参加者（領地の持ち主）"
  owner: Int!
  "止まった領地の位置"
  position: BoardPosition!
  "払った魔力"
  magic: Int!
}

"魔力が負の間に自分の領地を手放した（クリーチャーは盤面から外れ、土地は空いてレベル 1 に戻る）"
type MatchTerritoryRelinquishedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "手放した参加者（Match.participants の何番目か）"
  participant: Int!
  "手放した領地の位置"
  position: BoardPosition!
  "盤面から外れたクリーチャーの ID"
  creature: Int!
  "受け取った魔力"
  magic: Int!
}

"領地が無くなっても魔力が負のままだったので、拠点からやり直す（手札と山札はそのまま）"
type MatchMagicDepletedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "枯渇した参加者（Match.participants の何番目か）"
  participant: Int!
  "与えられた魔力（開始時の魔力）"
  magic: Int!
}

"サイコロを振った"
type MatchDiceRolledEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "振った参加者（Match.participants の何番目か）"
  participant: Int!
  "出た目"
  value: Int!
}

"1 マス進んだ"
type MatchMovedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "進んだ参加者（Match.participants の何番目か）"
  participant: Int!
  "入ったマスの位置"
  to: BoardPosition!
}

"まだ印の無いチェックポイントに入り、印を付けて魔力が増えた"
type MatchCheckpointPassedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "通った参加者（Match.participants の何番目か）"
  participant: Int!
  "印を付けたチェックポイントの位置"
  checkpoint: BoardPosition!
  "増えた魔力"
  magic: Int!
}

"全チェックポイントに印を付けて拠点に入り、周回を終えて魔力が増えた"
type MatchLapCompletedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "周回を終えた参加者（Match.participants の何番目か）"
  participant: Int!
  "増えた魔力"
  magic: Int!
}

"ターンを終えた"
type MatchTurnEndedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "ターンを終えた参加者（Match.participants の何番目か）"
  participant: Int!
}

"対戦が終わった"
type MatchEndedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "勝った参加者（Match.participants の何番目か）。魔力が同じならすべて"
  winners: [Int!]!
  "参加者ごとの順位（Match.participants の何番目かの順。1 が最上位）。魔力が同じなら同じ順位で、core が決める。目標の魔力で終わったときは勝った人が 1 位で、ほかの人は 2 位以下"
  ranks: [Int!]!
  "終わった理由"
  reason: MatchEndReason!
}

"戦利品のパックから引いた"
type MatchRewardDrawnEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "引いた参加者（Match.participants の何番目か）"
  participant: Int!
  "選んだパックのキー"
  pack: String!
  "引いたカード（重ならない。候補が足りなければ順位の枚数より少ない）。cards にしないのは、MatchHandsDealtEvent.cards（Int）と同じ名前で型が食い違い、問い合わせを検証で断られるため"
  rewardCards: [CardInfo!]!
}

"プレイヤー全員が戦利品を受け取った（対戦の流れの終わり）"
type MatchRewardsCompletedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"指した版より後の対戦のイベント"
type MatchEventList {
  "古い順にすべて（対戦の長さはラウンドの上限で決まるので、ページ分けしない）"
  events: [MatchEvent!]!
}

"対戦のイベントの結果。ログイン中のプレイヤーが未登録なら PlayerNotRegisteredError"
union MatchEventsResult = MatchEventList | MatchNotFoundError | PlayerNotRegisteredError

extend type Query {
  "自分が参加している対戦の、指した版より後のイベント（登録済みのプレイヤーだけ）。無い・参加していない対戦は MatchNotFoundError"
  matchEvents(
    "対戦の公開用の ID"
    id: UUID!
    "手元の版。これより後のイベントを返す（0 なら始めから）"
    after: Int!
  ): MatchEventsResult!
}
