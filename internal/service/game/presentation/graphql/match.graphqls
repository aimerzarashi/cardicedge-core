  participant: Int!
  "対象の参加者（Match.participants の何番目か）"
  target: Int!
  "かかった効果"
  effect: MatchLastingSpellEffect!
}

"スペルで、領地のクリーチャーにダメージを与えた（remainingHitPoints が 0 なら、続けて破壊される）"
