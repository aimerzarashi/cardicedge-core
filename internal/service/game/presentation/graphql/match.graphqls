"まだ印の無いチェックポイントに入り、印を付けて魔力が増えた"
type MatchCheckpointPassedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "通った参加者（Match.participants の何番目か）"
  participant: Int!
  "印を付けたチェックポイントの位置"
  checkpoint: BoardPosition!
  "増えた魔力"
  magic: Int!
}

"全チェックポイントに印を付けて拠点に入り、周回を終えて魔力が増えた"
type MatchLapCompletedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "周回を終えた参加者（Match.participants の何番目か）"
  participant: Int!
  "増えた魔力の合計（lapBonus + territoryBonus）"
  magic: Int!
  "増えた魔力の根拠の、周回のボーナス（領地の数によらない決まった額）"
  lapBonus: Int!
  "増えた魔力の根拠の、領地の分の額（territoryCount × lapBonusPerTerritory）"
  territoryBonus: Int!
  "増えた魔力の根拠の、周回を終えたときの自分の領地の数"
  territoryCount: Int!
  "増えた魔力の根拠の、領地 1 つあたりの額"
  lapBonusPerTerritory: Int!
}

"ターンを終えた"
type MatchTurnEndedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "ターンを終えた参加者（Match.participants の何番目か）"
  participant: Int!
}

"対戦が終わった"
type MatchEndedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "勝った参加者（Match.participants の何番目か）。魔力が同じならすべて"
  winners: [Int!]!
  "参加者ごとの順位（Match.participants の何番目かの順。1 が最上位）。魔力が同じなら同じ順位で、core が決める。目標の魔力で終わったときは勝った人が 1 位で、ほかの人は 2 位以下"
  ranks: [Int!]!
  "終わった理由"
  reason: MatchEndReason!
}

"戦利品のパックから引いた"
type MatchRewardDrawnEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "引いた参加者（Match.participants の何番目か）"
  participant: Int!
  "選んだパックのキー"
  pack: String!
  "引いたカード（重ならない。候補が足りなければ順位の枚数より少ない）。cards にしないのは、MatchHandsDealtEvent.cards（Int）と同じ名前で型が食い違い、問い合わせを検証で断られるため"
  rewardCards: [CardInfo!]!
}

"プレイヤー全員が戦利品を受け取った（対戦の流れの終わり）"
type MatchAllRewardsReceivedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"指した版より後の対戦のイベント"
type MatchEventList {
  "古い順にすべて（対戦の長さはラウンドの上限で決まるので、ページ分けしない）"
  events: [MatchEvent!]!
}

"対戦のイベントの結果。ログイン中のプレイヤーが未登録なら PlayerNotRegisteredError"
union MatchEventsResult = MatchEventList | MatchNotFoundError | PlayerNotRegisteredError

extend type Query {
  "自分が参加している対戦の、指した版より後のイベント（登録済みのプレイヤーだけ）。無い・参加していない対戦は MatchNotFoundError"
  matchEvents(
    "対戦の公開用の ID"
    id: UUID!
    "手元の版。これより後のイベントを返す（0 なら始めから）"
    after: Int!
  ): MatchEventsResult!
}
