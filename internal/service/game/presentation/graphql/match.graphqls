input ChooseMatchRewardPackInput {
  "対戦の公開用の ID"
  id: UUID!
  "画面が見ていた対戦の revision"
  revision: Int!
  "選ぶパックのキー（Match.rewardPacks の中から選ぶ。選べないものは ValidationErrors の FieldNotFound）"
  pack: String!
}

"戦利品のパックを選んでカードを引いた（成功したら対戦の revision が進む。カードは Match.participants の rewardCards で読み、所持品へはポリシーが足す）"
type ChooseMatchRewardPackSuccess {
  "対戦の公開用の ID"
  id: UUID!
  "操作した後の対戦の revision"
  revision: Int!
}

"戦利品はもう受け取った"
type MatchRewardAlreadyReceivedError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

"chooseMatchRewardPack の結果（ENDED の段階の、まだ受け取っていないプレイヤーだけ。番は問わない。終わっていなければ MatchPhaseNotAllowedError、受け取り済みなら MatchRewardAlreadyReceivedError。参加していない対戦は MatchNotFoundError）"
union ChooseMatchRewardPackResult =
    ChooseMatchRewardPackSuccess
  | ValidationErrors
  | MatchNotFoundError
  | MatchPhaseNotAllowedError
  | MatchRewardAlreadyReceivedError
  | RevisionConflictError
  | PlayerNotRegisteredError

extend type Mutation {
  "カードを引く"
  drawMatchCard(input: DrawMatchCardInput!): DrawMatchCardResult!
  "手札を 1 枚捨てる"
  discardMatchCard(input: DiscardMatchCardInput!): DiscardMatchCardResult!
  "サイコロを振る"
  rollMatchDice(input: RollMatchDiceInput!): RollMatchDiceResult!
  "分かれ道で行き先を選ぶ"
  chooseMatchPath(input: ChooseMatchPathInput!): ChooseMatchPathResult!
  "止まった空き地に、手札のクリーチャーを配置する（配置したらターンを終える）"
  placeMatchCreature(input: PlaceMatchCreatureInput!): PlaceMatchCreatureResult!
  "魔力が負の間に、自分の領地を手放す"
  relinquishMatchTerritory(input: RelinquishMatchTerritoryInput!): RelinquishMatchTerritoryResult!
  "領地コマンドを使える自分の領地のレベルを上げる（領地コマンド。他人の領地に止まっていれば続けて通行料を払い、ほかはターンを終える）"
  levelUpMatchLand(input: LevelUpMatchLandInput!): LevelUpMatchLandResult!
  "領地コマンドを使える自分の領地のクリーチャーを手札のクリーチャーと交換する（領地コマンド。他人の領地に止まっていれば続けて通行料を払い、ほかはターンを終える）"
  exchangeMatchCreature(input: ExchangeMatchCreatureInput!): ExchangeMatchCreatureResult!
  "領地コマンドを使える自分の領地のクリーチャーを動かす（領地コマンド。空き地へならそのまま止まったマスの決まりに進み、他人の領地へなら侵略と同じ戦闘をする）"
  moveMatchCreature(input: MoveMatchCreatureInput!): MoveMatchCreatureResult!
  "領地コマンドを使える自分の領地の土地の属性を変える（領地コマンド。他人の領地に止まっていれば続けて通行料を払い、ほかはターンを終える）"
  changeMatchLandElement(input: ChangeMatchLandElementInput!): ChangeMatchLandElementResult!
  "サイコロを振る前に、手札のスペルを使う（1 ターンに 1 枚まで。コストの分の魔力を払う）"
  useMatchSpell(input: UseMatchSpellInput!): UseMatchSpellResult!
  "止まった他人の領地を、手札のクリーチャーで侵略する（選んだ時点で確定し、コストの分の魔力を払う）"
  invadeMatchTerritory(input: InvadeMatchTerritoryInput!): InvadeMatchTerritoryResult!
  "侵略を確定した人が、アイテムを選ぶ（出さないことも選ぶ）"
  attackMatchTerritory(input: AttackMatchTerritoryInput!): AttackMatchTerritoryResult!
  "止まった他人の領地の通行料を払う"
  payMatchToll(input: PayMatchTollInput!): PayMatchTollResult!
  "侵略された領地の持ち主が、アイテムを選んで戦闘に進める（出さないことも選ぶ）"
  defendMatchTerritory(input: DefendMatchTerritoryInput!): DefendMatchTerritoryResult!
  "ターンを終える（PLACING では配置しない）"
  endMatchTurn(input: EndMatchTurnInput!): EndMatchTurnResult!
  "終わった後に、戦利品のパックを選ぶ（順位の枚数のカードを引く）"
  chooseMatchRewardPack(input: ChooseMatchRewardPackInput!): ChooseMatchRewardPackResult!
}

"""
対戦の進み。画面は手元の版（revision）と比べ、進んでいれば matchEvents で差分を、match で今の状態を読む。
版だけを送るのは、見せてよいものの絞り込みを query の側だけで行うため
"""
type MatchProgress {
  "対戦の公開用の ID"
  id: UUID!
  "対戦の最新の版（Match.revision と同じ。抜けなく 1 から続く）"
  revision: Int!
  "その版のイベントの起きた時刻"
  occurredAt: DateTime!
}

"対戦の進みの結果。ログイン中のプレイヤーが未登録なら PlayerNotRegisteredError"
union MatchProgressResult = MatchProgress | MatchNotFoundError | PlayerNotRegisteredError

extend type Subscription {
  """
  自分が参加している対戦の進み（登録済みのプレイヤーだけ）。つないだ直後に今の版を送り、版が進んだらすぐ、
  変わらなくても数秒ごとに送る（つながっていることの確認も兼ねる）。全員が戦利品を受け取り終えたら、その版を送ってから閉じる
  （対戦が終わっただけでは閉じない。受け取らないまま離れた人がいると閉じない）。
  無い・参加していない対戦は MatchNotFoundError を 1 回送って閉じる。SSE（graphql-sse）でつなぐ
  """
  matchProgress(
    "対戦の公開用の ID"
    id: UUID!
  ): MatchProgressResult!
}

"領地の価値と通行料"
type MatchTerritoryValue {
  "領地の位置"
  position: BoardPosition!
  "土地の価値（連鎖を含む）"
  value: Int!
  "盤面の通行料（価値 × 通行料の割合。いるクリーチャーの通行料の倍率は掛けず、払うときに発動する（MatchTollCreatureEffectActivatedEvent））"
  toll: Int!
  "土地のレベル（価値の根拠。レベルの倍率は MatchPlayRules.landLevelMultipliers）"
  level: Int!
  "連鎖の数（同じ持ち主の同じ属性の土地の数。自分を含み、複の土地はいつも 1。価値の根拠で、倍率は MatchPlayRules.chainMultipliers）"
  chainCount: Int!
  "このイベントの前の連鎖の数（同じクリーチャーの前の領地、無ければ同じ位置で同じ持ち主の前の領地のもの）。この持ち主の連鎖に新しく入った（配置した・奪った）なら null"
  previousChainCount: Int
}

"総魔力が変わった参加者"
type MatchTotalMagicChange {
  "参加者（Match.participants の何番目か）"
  participant: Int!
  "変わった後の総魔力"
  totalMagic: Int!
}

"""
このイベントで変わった、描画に要る値のうち、イベントの事実からは出せず core の決まりで決まるもの。
画面がイベントの再生で描くときに、計算せずに当てられるように返す。
保存するイベントの payload には持たない（読むときにイベントを順に当てて計算する）
"""
type MatchEventChanges {
  "このイベントの後の段階。操作を待っていない間（始まる前・移動の途中）は null"
  phase: MatchPhase
  "総魔力が変わった参加者だけ"
  totalMagics: [MatchTotalMagicChange!]!
  "価値・通行料・土地のレベル・連鎖の数のどれかが変わった領地だけ（できた順。無くなった領地は入らない）"
  territoryValues: [MatchTerritoryValue!]!
}

"""
対戦のイベント。種類ごとの型で見せ、見せないもの（山札の並び）は項目を持たない。
誰が（participant）は Match.participants の何番目か
"""
interface MatchEvent {
  "対戦の版（このイベントまで進んだ版。抜けなく 1 から続く）"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"対戦が始まった（参加者・盤面・ルールは match で読む）"
type MatchCreatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"順番が決まった"
type MatchTurnOrderDecidedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "参加者の番号（Match.participants の何番目か）を、順番の早い順に並べたもの"
  order: [Int!]!
}

"山札が混ざった（並びは見せないので、項目を持たない）"
type MatchDrawPilesShuffledEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
}

"全員に手札が配られた"
type MatchHandsDealtEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "全員に配った枚数（山札が足りなければ、ある分だけ）"
  cards: Int!
}

"カードを引いた"
type MatchCardDrawnEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "引いた参加者（Match.participants の何番目か）"
  participant: Int!
  "引いたカード"
  card: CardInfo!
}

"山札が空のまま引くときに、捨て札を混ぜて山札にした（並びは見せない）"
type MatchDiscardPileShuffledEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "混ぜた参加者（Match.participants の何番目か）"
  participant: Int!
  "山札にした枚数（捨て札はこれで空になる）"
  drawPileCount: Int!
}

"ターンを終えるときに、手札が上限を超えていた（上限まで捨ててからターンを終える）"
type MatchHandLimitExceededEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "手札が上限を超えた参加者（Match.participants の何番目か）"
  participant: Int!
  "上限を超えた時点の手札の枚数（捨てる枚数は handCount - maxHandCards）"
  handCount: Int!
  "手札の上限の枚数"
  maxHandCards: Int!
}

"手札を 1 枚捨てた（捨て札に入る）"
type MatchCardDiscardedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "捨てた参加者（Match.participants の何番目か）"
  participant: Int!
  "捨てた手札の番号（0 始まり）"
  handIndex: Int!
  "捨てたカード"
  card: CardInfo!
}

"止まった空き地に、手札のクリーチャーを配置した（そのままターンを終える）"
type MatchCreaturePlacedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "配置した参加者（Match.participants の何番目か）"
  participant: Int!
  "配置した手札の番号（0 始まり）"
  handIndex: Int!
  "配置したカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "配置したクリーチャーの ID（Match.territories の creature.id と同じ番号）"
  creature: Int!
  "配置した位置（領地になった）"
  position: BoardPosition!
  "払った魔力"
  cost: Int!
}

"止まった他人の領地を、手札のクリーチャーで侵略した"
type MatchTerritoryInvadedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "侵略した参加者（Match.participants の何番目か）"
  participant: Int!
  "出した手札の番号（0 始まり）"
  handIndex: Int!
  "出したカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "侵略した領地の位置"
  position: BoardPosition!
  "払った魔力"
  cost: Int!
  "領地にいて、これから戦う守る側のクリーチャーのカード（性能は対戦を始めたときの写し）"
  defendingCreatureCard: CardInfo!
}

"サイコロを振る前に、手札のスペルを使った（効果は続くイベント。スペルは捨て札に入る）"
type MatchSpellUsedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "使った参加者（Match.participants の何番目か）"
  participant: Int!
  "使った手札の番号（0 始まり）"
  handIndex: Int!
  "使ったカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "払った魔力"
  cost: Int!
}

"戦闘に手札のアイテムを出した（攻める側も守る側も同じ。効果はまだ無い）"
type MatchItemUsedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "出した参加者（Match.participants の何番目か）"
  participant: Int!
  "出した手札の番号（0 始まり）"
  handIndex: Int!
  "出したカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "払った魔力"
  cost: Int!
}

"戦闘にアイテムを出さなかった（攻める側も守る側も同じ）"
type MatchItemSkippedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "出さなかった参加者（Match.participants の何番目か）"
  participant: Int!
}

"戦闘のどちら側か"
enum MatchBattleSide {
  "攻める側（侵略した側）"
  ATTACKER
  "守る側（領地の持ち主）"
  DEFENDER
}

"領地コマンドを使える自分の領地のレベルを上げた"
type MatchLandLeveledUpEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "上げた参加者（Match.participants の何番目か）"
  participant: Int!
  "領地の位置"
  position: BoardPosition!
  "上げた後のレベル"
  level: Int!
  "払った魔力"
  magic: Int!
}

"領地コマンドを使える自分の領地のクリーチャーを空き地へ動かした（行き先が領地になり、元の土地は空き地になる。土地のレベルはどちらも土地に残る）"
type MatchCreatureMovedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "動かした参加者（Match.participants の何番目か）"
  participant: Int!
  "元の領地の位置"
  from: BoardPosition!
  "行き先"
  to: BoardPosition!
  "動いたクリーチャーの ID（同じ 1 体のまま）"
  creature: Int!
}

"領地コマンドを使える自分の領地のクリーチャーを他人の領地へ動かし、侵略した（続けてアイテムを選び、戦闘する）"
type MatchTerritoryInvadedByMoveEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "動かした参加者（Match.participants の何番目か）"
  participant: Int!
  "元の領地の位置"
  from: BoardPosition!
  "攻める領地の位置"
  position: BoardPosition!
  "動いたクリーチャーの ID"
  creature: Int!
  "動いたクリーチャーのカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "領地にいて、これから戦う守る側のクリーチャーのカード（性能は対戦を始めたときの写し）"
  defendingCreatureCard: CardInfo!
}

"領地コマンドを使える自分の領地の土地の属性を変えた（土地のレベルとクリーチャーはそのまま）"
type MatchLandElementChangedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "変えた参加者（Match.participants の何番目か）"
  participant: Int!
  "領地の位置"
  position: BoardPosition!
  "変えた後の属性"
  element: BoardTileElement!
  "払った魔力（baseLandValue × multiplier）"
  magic: Int!
  "払った魔力の根拠の、土地の基本の値"
  baseLandValue: Int!
  "払った魔力の根拠の、実際に掛けた倍率（複属性の土地からは安い倍率）"
  multiplier: Int!
}

"領地のクリーチャーを手札のクリーチャーと入れ替えた"
type MatchCreatureExchangedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "交換した参加者（Match.participants の何番目か）"
  participant: Int!
  "領地の位置"
  position: BoardPosition!
  "出した手札の番号（0 始まり）"
  handIndex: Int!
  "領地に入ったカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "領地に入ったクリーチャーの新しい ID（Match.territories の creature.id と同じ番号）"
  creature: Int!
  "払った魔力"
  cost: Int!
  "手札の最後に戻ったカード（性能は対戦を始めたときの写し）"
  returnedCard: CardInfo!
}

"戦闘の中の AT・HP"
type MatchBattleStats {
  "攻撃力"
  attack: Int!
  "体力"
  hitPoints: Int!
}

"戦闘が始まった（効果を当てる前の両方の AT・HP。領地のクリーチャーは、ボード上の効果と傷が残った今の値）"
type MatchBattleStartedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "攻める側"
  attacker: MatchBattleStats!
  "守る側"
  defender: MatchBattleStats!
}

# 戦闘の発動のイベントは、core と同じく出どころ（支援効果・地形効果・クリーチャーの能力・アイテムの能力）ごとに型を分ける（core#175）。
# どの型も change（増減と当てた後の値）を持つ。null を許すのは、同じ名前の項目の null の許し方が型ごとに食い違うと、画面が
# 1 つの問い合わせで全部の型を読めなくなるため（支援効果・地形効果は必ず持つ）
"戦闘の AT・HP の増減と、当てた後の値"
type MatchBattleStatChange {
  "AT の増減（下限の 0 で止まった後の実際の増減）"
  attackDelta: Int!
  "HP の増減（下限の 0 で止まった後の実際の増減）"
  hitPointsDelta: Int!
  "当てた後の AT"
  attack: Int!
  "当てた後の HP（0 ならその時点で破壊され、戦闘が終わる）"
  hitPoints: Int!
}

"支援効果が発動した（戦場の隣にあるその側の領地の数 × 1 つあたりの値だけ AT が増える。攻める側にも守る側にも付き、隣の領地が無い側には出ない）"
type MatchBattleSupportEffectActivatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "効果を受けた側"
  side: MatchBattleSide!
  "戦場の隣にある、その側の領地の位置"
  positions: [BoardPosition!]!
  "隣の領地 1 つあたりの AT の増加"
  bonusPerTerritory: Int!
  "増減と当てた後の値（いつもある）"
  change: MatchBattleStatChange
}

"守る側に地形効果が発動した（土地の属性がクリーチャーの属性と合えば、レベル × 1 レベルあたりの値だけ HP が増える。合わなければ出ない）"
type MatchBattleTerrainEffectActivatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "効果を受けた側（いつも DEFENDER）"
  side: MatchBattleSide!
  "土地の属性"
  element: BoardTileElement!
  "土地のレベル"
  level: Int!
  "レベル 1 つあたりの HP の増加"
  bonusPerLevel: Int!
  "増減と当てた後の値（いつもある）"
  change: MatchBattleStatChange
}

# 発動したカードの効果を activatedEffect に入れ子で持つのは、value・percent・effect をほかの対戦のイベントと同じ名前の項目にすると、
# 型が食い違って 1 つの問い合わせで読めなくなるため（core#177）。クリーチャーとアイテムで同じ形にする（core#178）
"""
クリーチャーの効果が発動した。先に・後に攻撃するは効き目が無いとき（両方が先に攻撃するで打ち消し合う等）も持っていれば出る。
受けるダメージを 0 にするは、攻撃してきたクリーチャーが制約を満たしたときだけ、その攻撃の前に出る。AT・HP を変える効果（増減・上書き）は増減が 0 でも出る
"""
type MatchBattleCreatureEffectActivatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "効果を持つクリーチャーの側"
  side: MatchBattleSide!
  "クリーチャーのカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "発動したカードの効果（種類と、下限で止まる前の値・上書きの範囲。受けるダメージを 0 にするは相手が制約を満たす最初のもの）"
  activatedEffect: Effect!
  "増減と当てた後の値（AT・HP を変える効果のときだけ。ほかは null）"
  change: MatchBattleStatChange
}

"出したアイテムの効果が発動した（増減・上書きは増減が 0 でも出る。倍率は掛けたものだけ、地形効果を無視するは相手に地形効果があるときだけ出る）"
type MatchBattleItemEffectActivatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "アイテムを出した側"
  side: MatchBattleSide!
  "アイテムのカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "発動したカードの効果（種類と、下限で止まる前の値。倍率は制約を満たす一番高いもの）"
  activatedEffect: Effect!
  "アイテムを出した側の増減と当てた後の値（AT・HP を変える効果のときだけ。地形効果を無視するは null）"
  change: MatchBattleStatChange
  "相手の増減と当てた後の値（地形効果を無視するときだけ。相手の HP が地形効果の分を除いた値になる。ほかは null）"
  opponentChange: MatchBattleStatChange
}

"戦闘の攻撃が 1 回当たった"
type MatchCreatureStruckEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "攻撃した側"
  striker: MatchBattleSide!
  "攻撃した側の、そのときの戦闘中の AT"
  attack: Int!
  "受けた側が受けた量（攻撃無効が発動したら 0）"
  damage: Int!
  "受けた側の、効果で増えた分も含む残りの体力（0 なら倒れた）"
  remainingHitPoints: Int!
}

"守る側のクリーチャーを倒して土地を奪った（土地のレベルは引き継ぐ）"
type MatchInvasionSucceededEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "奪った参加者（Match.participants の何番目か）"
  participant: Int!
  "奪った領地の位置"
  position: BoardPosition!
  "領地に入ったクリーチャーの新しい ID（Match.territories の creature.id と同じ番号）"
  creature: Int!
  "領地に入ったクリーチャーの体力"
  territoryHitPoints: Int!
}

"守る側のクリーチャーを倒せなかった（続けて通行料を払う）"
type MatchInvasionFailedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "侵略した参加者（Match.participants の何番目か）"
  participant: Int!
  "侵略した領地の位置"
  position: BoardPosition!
  "攻めたカード（性能は対戦を始めたときの写し）"
  card: CardInfo!
  "手札に戻ったか（生きていれば true。倒れていれば捨て札になり false）"
  returnedToHand: Boolean!
  "領地のクリーチャーに残る体力（増えた分を超えたダメージだけが傷になる）"
  territoryHitPoints: Int!
  "移動で侵略して生き残ったときだけ。戻った元の領地の位置（倒れたときは null で、元の土地は空き地になる）"
  returnedTo: BoardPosition
  "移動で侵略して生き残ったときだけ。戻ったクリーチャーの体力"
  returnedHitPoints: Int
}

"破壊されたクリーチャーの「破壊されたとき」の効果が発動した（破壊のイベントの直後。結果は続く MatchCardReturnedToHandEvent・MatchMagicReceivedEvent）"
type MatchDestructionCreatureEffectActivatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "今の番の参加者（Match.participants の何番目か）"
  participant: Int!
  "破壊されたクリーチャーの持ち主（Match.participants の何番目か）"
  owner: Int!
  "破壊されたクリーチャーのカード"
  card: CardInfo!
  "発動したカードの効果"
  activatedEffect: Effect!
}

"破壊されて捨て札に入ったカードが、持ち主の手札の最後に戻った（手札の上限は持ち主のターンの終わりに合わせる）"
type MatchCardReturnedToHandEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "今の番の参加者（Match.participants の何番目か）"
  participant: Int!
  "カードの持ち主（Match.participants の何番目か）"
  owner: Int!
  "戻ったカード"
  card: CardInfo!
}

"持ち主が魔力を受け取った（破壊されたら魔力を得る効果の結果）"
type MatchMagicReceivedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "今の番の参加者（Match.participants の何番目か）"
  participant: Int!
  "受け取った参加者（Match.participants の何番目か）"
  owner: Int!
  "受け取った魔力"
  magic: Int!
}

"通行料を払う直前に、領地のクリーチャーの通行料の倍率が発動した（倍率を持っていれば、効き目が無くても出る）。続く MatchTollPaidEvent が multipliedToll を払う"
type MatchTollCreatureEffectActivatedEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "止まった領地の位置"
  position: BoardPosition!
  "倍率（百分率。150 で 1.5 倍）"
  percent: Int!
  "盤面の通行料（倍率を掛ける前）"
  toll: Int!
  "倍率を掛けて切り捨てた、払う通行料"
  multipliedToll: Int!
}

"他人の領地に止まって通行料を払った（足りなくても全額を払い、魔力は負になる）"
type MatchTollPaidEvent implements MatchEvent {
  "対戦の版"
  revision: Int!
  "起きた時刻"
  occurredAt: DateTime!
  "このイベントで変わった、描画に要る core の決まりで決まる値"
  changes: MatchEventChanges!
  "払った参加者（Match.participants の何番目か）"
  participant: Int!
  "受け取った参加者（領地の持ち主）"
  owner: Int!
  "止まった領地の位置"
  position: BoardPosition!
  "払った魔力"
  magic: Int!
}

"魔力が負の間に自分の領地を手放した（クリーチャーは盤面から外れ、土地は空いてレベル 1 に戻る）"
