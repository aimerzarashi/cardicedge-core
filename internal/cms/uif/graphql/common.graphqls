# cms 用の GraphQL（/cms/graphql）。cms の better-auth の JWT（Authorization: Bearer）が無いと、どの操作も受け付けない
# 機能ごとのファイルは Query・Mutation を extend する（Mutation は、中身の無い型は置けないため、最初のミューテーションを足したときにここへ置いた）。
# 結果は「<操作>Result = <操作>Success | エラー型」の union で返す（未認証は union に含めず HTTP 401）。
# 認可（オペレーターでない）は ForbiddenError、入力の誤りは ValidationErrors を union に含めて返す

type Query {
  # GraphQL の仕様で Query が 1 つ以上要るため置く（ログイン中のオペレーターを返す me は、使う場面が出てくるまで作らない。core#7）
  "core の版（リリースのタグ。開発中は none）"
  version: String!
}

type Mutation

"公開用の ID（UUID の文字列）。core の内部の ID は返さない"
scalar UUID

"日時（RFC 3339 の文字列。例: 2026-10-17T09:00:00Z）"
scalar DateTime

"操作する権限が無い（JWT は正しいが、core のオペレーターとして登録されていない等）"
type ForbiddenError {
  "開発者向けの説明（画面にそのまま出す文言ではない）"
  message: String!
}

# 入力の誤り。理由ごとに型を分け、その理由に要る値だけを必須で持つ（理由によって null になる項目を作らないため）。
# 文言は返さない（言い回し・項目の呼び方は画面の都合なので、cms が __typename と値から作る）
"入力の項目ごとの誤り。理由は __typename で見分ける"
interface FieldError {
  "誤りのある入力の項目（GraphQL の引数・入力の項目名と同じ。入れ子の入力は filter.nameContains のように . でつなぐ）"
  field: String!
}

"入力が空（前後の空白だけの場合を含む）"
type FieldRequired implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力が長すぎる"
type FieldTooLong implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "上限の文字数"
  max: Int!
}

"入力が範囲の外"
type FieldOutOfRange implements FieldError {
  "誤りのある入力の項目"
  field: String!
  "範囲の下限（この値を含む）"
  min: Int!
  "範囲の上限（この値を含む）"
  max: Int!
}

"入力の形が正しくない（メールアドレスとして読めない、ページの位置（カーソル）が読めない等）"
type FieldInvalidFormat implements FieldError {
  "誤りのある入力の項目"
  field: String!
}

"入力の誤り（操作は行われていない）"
type ValidationErrors {
  "項目ごとの誤り（1 件以上）"
  errors: [FieldError!]!
}

# 一覧のページ分けは、Relay の決まり（Connection）の形にし、順方向（first・after）だけにする（core#12）
"ページの情報"
type PageInfo {
  "次のページがあるか"
  hasNextPage: Boolean!
  "前のページがあるか（after を指定したら true）"
  hasPreviousPage: Boolean!
  "このページの最初の 1 件の位置"
  startCursor: String
  "このページの最後の 1 件の位置（次のページは after にこれを渡す）"
  endCursor: String
}
